<script type="text/javascript">
	$(function(){
		var parentTop = $('#domemeMiddle').position().top;
		var elRightWing = $('#lDomemeHeaderRWingWrap');

		// 일정 스크롤이 지나면 오른쪽날개의 상단은 날아가고 목록만 fixed
		$(document).scroll(function(){
			var scroll	= $(document).scrollTop();

			if(scroll > parentTop)
			{
				elRightWing.addClass('lFixed');
			}
			else
			{
				elRightWing.removeClass('lFixed');
			}
		});
	});

	$(function(){
		/* 구매완료수 */
		$('.buyCnt_slider').flexslider({
			animation: "fade",//fade slide
			controlNav: false,
			directionNav: false,
			//   animationLoop: false,
			slideshow: true,
			slideshowSpeed: 4000,
			//  sync: "#carousel",
			start: function(slider){
				$('body').removeClass('loading');
			}
		});
	});

	$(function(){		
		// TOP 버튼
		$('#lRWingTop').on('click', function(e){
			scrollTo(0,0);
		});
	});
</script></div>
<script type="text/javascript">
	//자바스크립트 실행순서 강제조정
	window.onload	= function()
	{
		if(crossDomainSupportflag)
		{
			crossDomainSupport();
			delete crossDomainSupport;
		}

		if(viewRightWingflag)
		{
			lDomemeHeaderRWingItemsMenuFnc(lDomemeHeaderRWingItemsMenuCurrNum);
		}
	}


	/*-----------------------------------------------------------------
	최상단 메뉴바
	-----------------------------------------------------------------*/
	//도매매 앱 레이어 관련 자바스크립트 입니다.
	$(document).ready(function()
	{
		/*
		* 도매매 앱 QR코드 관련 실행 흐름
		* 1. 첫 로딩시, 무조건 QR코드 레이어는 닫힌다.
		* 2. 앱 다운로드 탭을 hover하면, QR코드 레이어가 실행된다.
		* 3. 앱 다운로드 탭이나 QR코드 레이어에서 마우스가 떠나면 창이 닫힌다.
		*/
		$('#appDownload').bind('mouseenter', function(){
			$('#domeggookAppLayer').show();
		}).bind('mouseleave', function(){
			$('#domeggookAppLayer').hide();
		});
	});

	//북마크 관련 자바스크립트 함수입니다.
	function lBookmarksite()
	{
		var url		= window.location.href;
		var title	= '배송대행B2B서비스 - 도매매';
		var trigger	= false;

		if(window.external && ('AddFavorite' in window.external))
		{
			//IE
			window.external.AddFavorite(url, title);
		}
		else if(window.sidebar && window.sidebar.addPanel)
		{
			//Firefox version < 23
			window.sidebar.addPanel(title, url, '');
		}
		else if((window.sidebar && (navigator.userAgent.toLowerCase().indexOf('firefox') > -1)) || (window.opera && window.print))
		{
			//Firefox version >= 23 and Opera Hotlist
			var $this	= $(this);

			$this.attr('href', url);
			$this.attr('title', title);
			$this.attr('rel', 'sidebar');
			$this.off(e);

			trigger		= true;
		}
		else
		{
			//WebKit - Safari/Chrome, or Microsoft Edge
			alert('사용중인 브라우저에서는 (' + (navigator.userAgent.toLowerCase().indexOf('mac') != -1 ? 'Cmd' : 'Ctrl') + '+D) 를 눌러 즐겨찾기 할 수 있습니다.');
		}

		return trigger;
	}

	/*
	//최상단 메뉴바 오른쪽 영역에서 서브메뉴를 내리는데 사용하는 자바스크립트입니다.
	$('ul#rightMenu').on('mouseenter', 'li.subMenu', function(){
		$(this).find('ul').show();
	}).on('mouseleave', 'li.subMenu', function(){
		$(this).find('ul').hide();
	});
	*/
</script>

<script type="text/javascript">
// 브라우저 정중앙+좌측날개에서 도매매처음이세요? 창이 열리는 기능
function domemeGuidePopup()
{
	var w	= window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
	var h	= window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;

	var t	= h * 0.2;
	var l	= w * 0.3;

	window.open('/main/popup/supply/popup_domemeGuide.php', '', 'top=' + t + ', left=' + l + ', width=700, height=570');
}
</script>

