<!-- 검색창 제어 함수 -->
<script language="javascript">
	function searchItemChk(obj)
	{
		obj.sw.value == trim(obj.sw.value);

		/*
		영어 오타 변환
		2007.08.23 by 신동규
		obj.sw.value=toKorean(obj.sw.value);
		*/

//		if(!obj.sw.value)
//		{
//			try
//			{
//				if(checkBannerSearchUrl() == 'STOP')
//				{
//					return false;
//				}
//			}
//			catch(e)
//			{
//
//			}
//
//			document.location.href='/main/item/itemMD.php';
//			return false;
//		}

		/*시작 06.11.02 이선진 추가*/
		if(obj.sw.value ==''){
			alert("검색할 항목에 값을 입력하세요.");
			return false;
		}

		/*
		if(obj.sw.value.length <= 1){
			alert("검색할 값을 두자 이상을 입력하세요.");
			return false;
		}
		*/

		/*종료 06.11.02 이선진 추가*/

		if(obj.sf.value != 'no' && eregi("^(se|sh|bz|by)?[0-9]+$", trim(obj.sw.value)))
		{
			if(confirm("상품번호로 검색하겠습니까?"))
			{
				obj.sf.value	= 'no';
				obj.sw.value	= eregi_replace("[^0-9]", "", obj.sw.value);
			}
		}

		/*시작 06.11.02  특수문자 제한 이선진 추가*/
		/*
		//keyword_sp_char = "~`!@#$%^&*=|\\<,>?/{}[]:\"'()[]~:+";

		if(CheckSpecialChar(obj.sw.value, keyword_sp_char) == false)
		{
			alert("특수문자(" + keyword_sp_char + ")를 입력하실 수 없습니다.");
			return false;
		}
		*/
		/*종료 06.11.02  특수문자 제한 이선진 추가*/

		// 특수문자 제거
		obj.sw.value = obj.sw.value.replace(/[^a-zA-Z가-힣.0-9\s\-_\/]+/g, '');

		if(obj.sf.value == 'no')
		{
			switch(obj.code)
			{
				default:
				case 'dome':
					location.href = '/' + obj.sw.value;
					break;

				case 'panchok':
					location.href = '/p/' + obj.sw.value;
					break;

				case 'supply':
					location.href = '/s/' + obj.sw.value;
					break;

				case 'equip':
					location.href = '/e/' + obj.sw.value;
					break;
			}
			return false;
		}
	}


	/*시작 06.11.02  특수문자 제한 이선진 추가*/
	function CheckSpecialChar(str, special_char)
	{
		var flag = true;

		for(i = 0; i <= str.length;  i++)
		{
			ch = str.charAt(i);
			for(j = 0; j < special_char.length; j++)
			{
				if(ch == special_char.charAt(j))
				{
					flag = false;
					break;
				}
			}
			if(flag == false)
				break;
		}
		return flag;
	}
	/*종료 06.11.02  특수문자 제한 이선진 추가*/
</script>


