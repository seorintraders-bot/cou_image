	<script type="text/javascript">
	// 판매자 정보 더보기
	$('#lBtnShowSellerInfo').click(function(){
		$('#lSellerPopInfoDetail').appendTo('#lInfoSellerId').addClass('lShown')
	})

	// 샘플 팝업레이어
	function samplePopupLayer(sel, cnt)
	{
		var sampleLayerId = document.getElementById("sampleLayer");
		if(sel == 'over')
		{
			sampleLayerId.style.visibility = 'visible';
		}
		else if(sel == 'out')
		{
			sampleLayerId.style.visibility = 'hidden';
		}
	}

	function sampleDiscountPopupLayer(sel)
	{
		var sampleDiscountConId = document.getElementById("sampleDiscountCon");

		if(sel == 'over')
		{
			sampleDiscountConId.style.visibility = 'visible';
		}
		else if(sel == 'out')
		{
			sampleDiscountConId.style.visibility = 'hidden';
		}
	}


	// 흥정하기-구매자 팝업
	function buyNegoPopfunc(itemNo, doUse)
	{
		// var popUrl = "/sc/deal/buyNegoPop?no="+itemNo;
		var popUrl = "https://mobile.domeggook.com/itemNego/add/" + itemNo + "?";

		if(doUse)
		{
			popUrl += "type=deli";
		}
		else
		{
			popUrl += "type=item";
		}

		var negoPop	= window.open(popUrl, "buyNegoPop","width=600,height=850,top=100,left=30,scrollbars=yes,resizable=no");
		negoPop.focus();

		return false;
	}
/*
	// 흥정하기-구매자 팝업(구버전)
	function buyNegoPopfunc(itemNo, doUse)
	{
		var popUrl = "/sc/deal/buyNegoPop?no="+itemNo;
		if(doUse)
		{
			popUrl += "&do=1";
		}
		var negoPop	= window.open(popUrl, "buyNegoPop","width=800,height=850,top=100,left=30,scrollbars=yes,resizable=no");
		negoPop.focus();
		return false;
	}
*/

	// 랭킹지수 팝업 레이어
	$(document).ready(function()
	{
		$("body").bind('click', function(e)
		{
			$("#lRankInfoLayer").hide();
		});

		$("#lRankInfoLayer").bind('click', function(e){
			if(e.stopPropagation)
			{
				e.stopPropagation();
			}
			else
			{
				e.cancelBubble = true;
			}
		});

		$('#lInfoItemRank button').on('click', function(e){
			if(e.stopPropagation)
			{
				e.stopPropagation();
			}
			else
			{
				e.cancelBubble = true;
			}

			$("#lRankInfoLayer").show();
		})
	});


	function lowestPriceInfoLayer(v)
	{
		if(v)
		{
			$('.lowestPriceInfoLayer').show();
		}
		else
		{
			$('.lowestPriceInfoLayer').hide();
		}
	}


	(function(){
		/*-----------------------------------------------------------------
		상단 도매/배송대행 탭 기능
		-----------------------------------------------------------------*/
		var infoTabController = new function()
		{
			var _inst = this;

			this.elInfoTab = $('#lInfoTab');

			_init();

			function _init()
			{
				// 데이터 변경 구독
				window.lItem.store.subscribe('SET_MARKET', function(nextState, prevState){
					// 탭 버튼 클래스 상태 변경
					_inst.elInfoTab.find('.lBtn[data-market]').removeClass('lSelected')
					_inst.elInfoTab.find('.lBtn[data-market=' + nextState.market + ']').addClass('lSelected')

					// body 변경
					$('.lInfoBody').removeClass('lSelected')
					$('.lInfoBody[data-market=' + nextState.market + ']').addClass('lSelected')
				})

				// add event
				$('#lInfoTab').on('click', '.lBtn[data-market]', function(){
					var btn = $(this),
						market = btn.attr('data-market');

					// 데이터 변경
					window.lItem.store.dispatch({
						type	: 'SET_MARKET',
						market	: market
					})
				})
			}
		}


		/*-----------------------------------------------------------------
		판매단가(수량별할인단가) 테이블
		-----------------------------------------------------------------*/
		var amtTblController = new function()
		{
			_init();

			// 초기화
			function _init()
			{
				// 초기 데이터 가져오기
				var state = window.lItem.store.getState();

				// 초기 데이터 설정
				_setBaseAmt(state.baseAmtDome, state.baseAmtDomeIdx)

				// 데이터 변경 이벤트 구독
				window.lItem.store.subscribe('SET_BASE_AMT_DOME', function(state){
					// 변경된 적용단가 금액과 index 적용
					_setBaseAmt(state.baseAmtDome, state.baseAmtDomeIdx)
				})
			}

			// 적용단가 금액 및 index 변경
			function _setBaseAmt(amt, idx)
			{
				// 적용단가 테이블 index 변경
				$('.lInfoAmt table tr .lSelected').removeClass('lSelected')

				// idx가 -1이면 해당하는 구역이 없음
				if(idx >= 0)
				{
					$('.lInfoAmt table tr [data-idx="' + idx + '"]').addClass('lSelected')
				}
			}
		};


		/*-----------------------------------------------------------------
		배송정보 안내 레이어
		-----------------------------------------------------------------*/
		var deliTblController = new function()
		{
			// 레이어 열기 버튼
			$('.lBtnShowDeliInfo').on('click', function(e){
				var market = $(this).attr('data-market');
				var btn = $(this);
				var layer;

				// 다른 레이어 닫기
				$('.lItemViewLayer').not('[data-market="' + market + '"][data-key="deli"]').removeClass('lShown')

				// 선택한 탭의 배송정보 안내 레이어 열기
				layer = $('.lItemViewLayer[data-market="' + market + '"][data-key="deli"]');

				if(layer.hasClass('lShown'))
				{
					layer.removeClass('lShown')
				}
				else
				{
					layer
						// .appendTo($('body'))
						// .css({
						// 	top: btn.offset().top,
						// 	left: btn.offset().left - layer.outerWidth() - 10
						// })
						.addClass('lShown')
				}

				return false;
			})

			// 데이터 변경 이벤트 구독
			window.lItem.store.subscribe('SET_MARKET', function(state, prevState) {
				// market 데이터가 변경될때 배송정보 안내 테이블 레이어 닫기
				if(state.market != prevState.market)
				{
					$('.lItemViewLayer').removeClass('lShown')
				}
			})
		}



		/*-----------------------------------------------------------------
		쿠폰받기
		-----------------------------------------------------------------*/
		var couponController = new function()
		{
			var isMember			= '';
			var isCouponDiscount	= '';
			var couponFlag			= ''; // 쿠폰 발급여부 false 발급가능
			var isCouponUsed		= ''; // 발급된 쿠폰 사용여부 false 미사용
			var itemNo				= '60519599';
			var eventNo				= '';
			
			// 쿠폰할인상품
			if(!isCouponDiscount)
			{
				$('.lGGookDealCouponBtn').hide();
				return false;
			}

			// 쿠폰발급가능여부
			if(isMember)
			{
				var str = '';
				
				// 쿠폰 발급 불가
				if(!couponFlag)
				{	
					// 쿠폰사용
					if(isCouponUsed)
					{
						str = '쿠폰사용완료';
					}
					// 쿠폰미사용
					else
					{
						str = '쿠폰발급완료';
					}
						
					$('.lGGookDealCouponBtn').addClass('lDisabled');
					$('.lGGookDealCouponBtn .box2> span').text(str);
					
					// 우측 쿠폰 받기 버튼
					$('#lRightCouponDownWrap').hide();

				}
				// 쿠폰 발급 가능
				else
				{
					$('.lGGookDealCouponBtn').removeClass('lDisabled');
					$('.lGGookDealCouponBtn .box2 > span').text('쿠폰받기');
				}
			}
			else
			{
				$('.lGGookDealCouponBtn').removeClass('lDisabled');
				$('.lGGookDealCouponBtn .box2 > span').text('쿠폰받기');
			}
		
			$('.lGGookDealCouponBtn').on('click', function(e){
				
				try
				{
					// 회원이 아닌 경우
					if(!isMember)
					{
						throw ({
							msg: '로그인 후 이용해주세요',
							url: '/main/member/mem_formLogin.php?back=L3MvNjA1MTk1OTk%2Fbm89NjA1MTk1OTkmbWFya2V0PXN1cHBseQ%3D%3D',
							redirect : true
						});
					}

					// 회원이지만 쿠폰 발급이 불가한 경우
					if(isMember && !couponFlag)
					{
						throw ({
							msg: '이미 쿠폰이 발급 되었습니다',
							url: '',
							redirect : false
						});
					}
				}
				catch(e)
				{
					if(e.redirect)
					{							
						if(confirm(e.msg))
						{
							location.href = e.url;
						}
					}
					else
					{
						alert(e.msg);
					}

					return false;
				}

				$.ajax({
					method		: "GET",
					url			: "/main/item/itemGGookDealMobileAjax.php",
					data		:
					{
						type	: 'view',
						itemNo	: itemNo,
						eventNo : eventNo
					},
					dataType	: "json"
				}).done(function(dat){

					if(!dat.result)
					{
						alert(dat.message);
						console.log(dat);
						return false;
					}

					if(dat && dat.result)
					{	
						location.reload();
					}
				}).error(function(dat){
					console.log(dat);
				});
			});
		}
	})();

	// 도움말 팝업레이어 표시
	function popupInfoLayer(layerId, show)
	{
		// layerId 
		if(!layerId) 
		{
			return false;
		}

		var layer = $('#' + layerId);
		
		if(!layer.length)
		{
			return false;
		}

		var icoOffset = $('.icoPopupInfo').offset();
		var infoBodyOffset = $('#lInfoBody').offset();
	 
		if(show) 
		{
			layer.css({
				position: 'absolute',
				top		: (icoOffset.top - infoBodyOffset.top) + 30 + 'px',
				left	: (icoOffset.left - infoBodyOffset.left) - 175 + 'px'
			}).show();
		} 
		else 
		{
			layer.hide();
		}

		return true;
	}
	</script>

</div>

