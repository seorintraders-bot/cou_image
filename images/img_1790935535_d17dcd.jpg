		#lInfoWrap #lInfoTab .lBtn
		{
			z-index				: 20;
			position			: relative;
			width				: 130px;
			height				: 44px;
			border-top			: 1px solid #EEE;
			border-bottom		: 1px solid #DDD;
			font-size			: 16px;
			color				: #4F4F4F;
			vertical-align		: top;
		}
		#lInfoWrap #lInfoTab .lBtn.lSelected
		{
			border				: 1px solid #DDD;
			border-top			: 2px solid #1EC400;
			border-bottom		: none;
			font-weight			: bold;
			color				: #1EC400;
			background-color	: #FFF;
		}
		#lInfoWrap #lInfoTab .lBtn[data-market=supply].lSelected
		{
			border-top-color	: #FF643D;
			color				: #FF643D;
		}
		#lInfoWrap #lInfoTab .lBottomBorder
		{
			z-index				: 10;
			position			: absolute;
			bottom				: 0;
			left				: 0;
			right				: 0;
			height				: 1px;
			background-color	: #DDD;
		}

		/* 흥정하기, 대량구매 버튼 */
