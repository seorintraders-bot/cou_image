<script>
	
	//리뷰 삭제 기능
	function delReview(delBtn,pg)
	{
		var reviewNo = delBtn.dataset['no'];

		if(confirm('이 구매후기를 삭제하겠습니까?'))
		{
			$.ajax({
				url			: "/main/item/itemView/reviewDelIng.php",
				method		: "POST",
				data		: {"reviewNo": reviewNo},
				dataType	: "html"
			}).done(function(res){
				if(res.length)
				{
					alert(res);
				}
				else
				{
					drawReviewTbody(pg);
				}
			}).error(function(res){});
		}
	}
	
	const root = document.getElementsByTagName('html')[0];
	const wing = document.querySelector('#lRWing');

	// 모달 off 1번 방법(레이어 클릭 시)
	window.addEventListener('click', (e) => {
		// 모든 모달 중 켜진거 찾아서 꺼줌
		var modal		= document.getElementsByClassName('modal');
		let modalArr 	= Array.from(modal);

		if(modalArr.includes(e.target))
		{
			e.target.style.display = 'none';
			wing.style.zIndex = 10; //z-index 복구
			root.classList.remove('hidden');
		}
	})

	// 모달 off 2번 방법(버튼 클릭 시)
	function closeModal(btn)
	{	
		// 부모 노드 none처리
		btn.parentNode.parentNode.style.display = 'none';
		wing.style.zIndex = 10; //z-index 복구
		root.classList.remove('hidden');
	}

	// 모달 on(프리미엄 구매후기)
	function showPremiumModal(num,no)
	{
		// swiper initialize(슬라이드 생성)
		var galleryThumbs = new Swiper('.pr-thumbs-class-' + num , {
			spaceBetween: 8,
			slidesPerView: 10,
			freeMode: true,
			watchSlidesProgress: true,
			observer : true,
			observeParents: true
		});

		var galleryTop = new Swiper('.pr-gallery-top-' + num, {
			spaceBetween: 8,
			/* navigation: {
			 	nextEl: ".swiper-button-next",
			 	prevEl: ".swiper-button-prev",
			 },*/
			thumbs: {
				swiper: galleryThumbs,
			},
			observer : true,
			observeParents: true,
		}); 

		var modal 	= document.getElementsByClassName('lPremiumReview'+num);

		// 모달 on
		if(modal[0].style.display == 'none')
		{
			modal[0].style.display = 'block';
			wing.style.zIndex = 0; //z-index 안먹혀서 강제로 적용
			root.setAttribute( 'class', 'hidden' ); // 스크롤 금지
			
			setTimeout(() => {
				galleryTop.slideTo(no);
			}, 0);
		}
	}

	// 모달 on(구매후기)
	function showModal(num,no)
	{
		// swiper initialize(슬라이드 생성)
		var galleryThumbs = new Swiper('.thumbs-class-' + num , {
			spaceBetween: 8,
			slidesPerView: 10,
			freeMode: true,
			watchSlidesProgress: true,
			observer : true,
			observeParents: true,
		});

		var galleryTop = new Swiper('.gallery-top-' + num, {
			spaceBetween: 8,
			// navigation: {
			// 	nextEl: ".swiper-button-next",
			// 	prevEl: ".swiper-button-prev",
			// },
			thumbs: {
				swiper: galleryThumbs,
			},
			observer : true,
			observeParents: true,
		}); 

		var modal 	= document.getElementsByClassName('lReview'+num);

		// 모달 on
		if(modal[0].style.display == 'none')
		{
			modal[0].style.display = 'block';
			wing.style.zIndex = 0; //z-index 안먹혀서 강제로 적용
			root.setAttribute( 'class', 'hidden' ); // 스크롤 금지
			
			setTimeout(() => {
				galleryTop.slideTo(no);
			}, 0);
		}
	}

	var reScrollFlag = false;

	window.addEventListener('scroll', function() {
		if(reScrollFlag)
		{
			return false;
		}

		reScrollFlag = true;

		drawScoreRate();
		drawPremiumReviewTbody();
		drawReviewTbody(1);
	});

	// 후기 페이지네이션 클릭 시 상단으로 이동
	$(document).on("click", '#lReviewPage a', function(event) {
		$('html, body').animate({
			scrollTop: $("#lClickReviewPag").offset().top - 100
		}, 500);
	});

</script>


