			<td style="position:relative;">
				<a class="thumbLightbox" href="#" rel="lightbox" title="겨울 방한 기모 똑딱이 넥워머 LM-0542" style="width:550px; height:550px;">
					<img id="lThumbImg" src="https://cdn1.domeggook.com/upload/item/2025/09/02/1756797059DF722DEB474952F96B3378/1756797059DF722DEB474952F96B3378_img_760?hash=092f6b0b96a726716911571c7700a7bd" class="mainThumb" alt="상품 섬네일 이미지" title="상품 섬네일 이미지" />
				</a>
				<script>
					(function(){
						var img = $('#lThumbImg');

						img.on('load', function(){
							var width = img.width();
							var height = img.height();
							var targetSize = Math.max(width, height);
							var rate;
							var newWidth, newHeight;

							// 가로 또는 세로 길이가 550보다 큰 경우
							if(targetSize > 550)
							{
								rate = 550 / targetSize;
								newWidth = width * rate;
								newHeight = height * rate;
								img.css({
									width: newWidth,
									height: newHeight
								})
							}
						})
					})();
				</script>
				
								<img
				src="https://cdn1.domeggook.com/image/item/img_lensSearch2.png"
				alt="꾹AI:렌즈" title="꾹AI:렌즈"
				style="
					width:auto;
					height:46px;
					display:flex;
					position:absolute;
					z-index:9999;
					right:30px;
					bottom:30px;
					cursor:pointer;
					"
				onclick="submitLensSearch('https://cdn1.domeggook.com/upload/item/2025/09/02/1756797059DF722DEB474952F96B3378/1756797059DF722DEB474952F96B3378_img_760?hash=092f6b0b96a726716911571c7700a7bd')"
				/>
				<script>
				function submitLensSearch(imageUrl)
				{
					var backUrl		= '/main/item/itemAILensItemList.php';
					// 기존 폼 제거
					var oldForm = document.getElementById('lensSearchForm');
					if (oldForm) oldForm.remove();
					
					// form 생성
					var form = document.createElement('form');
					form.id = 'lensSearchForm';
					form.method = 'POST';
					form.action = backUrl;
					form.target = '_blank';
					
					// hidden input 생성
					var input = document.createElement('input');
					input.type  = 'hidden';
					input.name  = 'image_url';   // 백엔드에서 받을 파라미터명
					input.value = imageUrl;
					form.appendChild(input);
					
					var input2 = document.createElement('input');
					input2.type  = 'hidden';
					input2.name  = 'mode';   // 백엔드에서 받을 파라미터명
					input2.value = 'url';
					form.appendChild(input2);
					document.body.appendChild(form);
					form.submit();
				}
				</script>
			</td>
		</tr>
