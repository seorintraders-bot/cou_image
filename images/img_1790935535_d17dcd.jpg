<script type="text/javascript" language="javascript">
	/* Script Init */
	var imageLinkHost = "https://imgprimary.domeggook.com";
	var imageLinkMirror = "https://cdn1.domeggook.com";
	var locationUrlEnc = "%2Fmain%2Fitem%2FitemView.php%3Fno%3D3045560";

	
	var systemVersion	= "v6";

	function chkLogin(obj)
	{
		obj.id.value	= trim(obj.id.value);
		obj.pass.value	= trim(obj.pass.value);
		obj.id.value	= obj.id.value.toLowerCase();
//		obj.pass.value	= obj.pass.value.toLowerCase();

		var pwdPattern	= /^[0-9a-zA-Z\`\~\!\@\#\$\%\^\&\*\(\)\-\_\=\+\{\}\[\]\\\|\;\:\'\"\,\<\.\>\/\?]{4,20}$/;

		if(!ereg("^[0-9a-z_-]{4,20}$",obj.id.value))
		{
			alert("회원아이디는 4~20자이내의 영문 또는 숫자로 이루어져야 합니다");
			obj.id.focus();
			return false;
		}

		if(!pwdPattern.test(obj.pass.value))
		{
			alert("비밀번호는 4~20자이내의 영문, 숫자 또는 특수문자로 이루어져야 합니다");
			obj.pass.focus();
			return false;
		}

		
		if(document.saveId)
		{
			obj.save.value = (document.saveId.save.checked) ? 'checked' : '';
		}

		return true;
	}
</script>
