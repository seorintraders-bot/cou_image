	/* #itemView #lReview table#lPremiumReviewTbl .lBest
	{
		border				: 1px solid #52A749;
		color				: #52A749;
		font-size			: 14px;
		line-height			: 19px;
		font-weight			: 600;
	} */
	/*---------------------------------------------
		모달
	----------------------------------------------*/
	.modal 
	{ 
		display				: none;
		position			: fixed;
		inset				: 0px;
		z-index				: 2147483647;
		width				: 100%;
		height				: 100%;
		margin				: 0px auto;
		background-color	: rgba(0, 0, 0, 0.7);
		overflow			: hidden auto;
	}
	.hidden 
	{
		height				: 100%;
		min-height			: 100%;
		overflow			: hidden !important;
		touch-action		: none;
	}
	.modal_body 
	{ 
		position			: absolute;
		top					: 50%; 
		left				: 50%; 
		width				: 660px; 
		padding				: 40px; 
		text-align			: center;
		transform			: translateX(-50%) translateY(-50%);
	}
	.modal_del 
	{ 
		position			: absolute;
		top					: 1%;
		left				: 99%;
		font-size			: 32px;
		color				: #fff;
		padding				: 40px;
		text-align			: center;
		transform			: translateX(-50%) translateY(-50%);
		cursor				: pointer;
	}
	.modal_del img
	{ 
		width				: 42px !important;
		height				: 50px !important;
	}


	/*---------------------------------------------
		슬라이드
	----------------------------------------------*/
	.modal_body .swiper 
	{
		width				: 100%;
		height				: 100%;
	}
	.modal_body .swiper-slide 
	{
		text-align			: center;
		font-size			: 18px;
		background			: #000;

		/* Center slide text vertically */
		display				: -webkit-box;
		display				: -ms-flexbox;
		display				: -webkit-flex;
		display				: flex;
		-webkit-box-pack	: center;
		-ms-flex-pack		: center;
		-webkit-justify-content: center;
		justify-content		: center;
		-webkit-box-align	: center;
		-ms-flex-align		: center;
		-webkit-align-items	: center;
		align-items			: center;
	}
	.modal_body .swiper-slide img 
	{
		display				: block;
		width				: 100% !important;
		height				: 100%!important ;
		object-fit			: contain;
		cursor				: pointer;
	}
	.modal_body .swiper 
	{
		width				: 100%;
		height				: 76px;
		margin-left			: auto;
		margin-right		: auto;
	}
	.modal_body .swiper-slide 
	{
		background-size		: cover;
		background-position	: center;
	}

	.modal_body .pr_swiperTop,
	.modal_body .swiperTop
	{
		height				: 660px;
		width				: 100%;
	}
	
	.modal_body .pr_swiperThumbs,
	.modal_body .swiperThumbs
	{
		box-sizing			: border-box;
		padding				: 10px 3px;
	}
	.modal_body .pr_swiperThumbs .swiper-slide,
	.modal_body .swiperThumbs .swiper-slide
	{
		width				: 57px !important;
		height				: 57px;
		overflow			: hidden;
	}
	.modal_body .pr_swiperThumbs .swiper-slide-thumb-active,
	.modal_body .swiperThumbs .swiper-slide-thumb-active
	{
		opacity				: 1;
		border				: 2px solid #52A749;
	}
	.modal_body .pr_swiperThumbs .swiper-slide-thumb-active img,
	.modal_body .swiperThumbs .swiper-slide-thumb-active img
	{
		
	}
	.modal_body .pr_swiperThumbs .swiper-slide img,
	.modal_body .swiperThumbs .swiper-slide img 
	{
		display				: block;
		width				: 57px;
		height				: 57px;
		object-fit			: cover;
		transform			: scale(1.8);
	}

	.modal_body .swiper-button-next::after,
	.modal_body .swiper-button-prev::after 
	{
		display				: none;
	}

/* 화살표 추가 시 나중에 아래 css 주석 해제
	 .swiper-button-next
	{
		top					: 43%;
		right				: 0px;
		background			: url('https://cdn1.domeggook.com/image/item/img_photoRightArrow.png') no-repeat;
		background-size		: 100% auto;
		background-position	: center;
	}
	.swiper-button-prev
	{
		top					: 43%;
		left				: 0px;
		background			: url('https://cdn1.domeggook.com/image/item/img_photoLeftArrow.png') no-repeat;
		background-size		: 100% auto;
		background-position	: center;
	} 
	*/
</style>

<script>
/*-----------------------------------------------------------------
	별점평균
-----------------------------------------------------------------*/
var drawScoreRate = function()
{
	$.ajax({
		url			: "/main/item/itemView/reviewAjax.php",
		method		: "GET",
		data		: {"mode":"score","itemNo": 60519599, "total": 0},
		dataType	: "json",

	}).done(function(dat){
		if(dat.avr)
		{
			$('#lReviewScoreWrap').css('display', 'flex');

			$('.lHighlight').removeClass();

			$('.lScoreText > b').text(dat.avr);

			$('.lFiveDiv').css('width', dat.width1);
			$('.lFourDiv').css('width', dat.width2);
			$('.lThreeDiv').css('width', dat.width3);
			$('.lTwoDiv').css('width', dat.width4);
			$('.lOwnDiv').css('width', dat.width5)

			$('.lFiveSpan').css('height', dat.rateA);
			$('.lFourSpan').css('height', dat.rateB);
			$('.lThreeSpan').css('height', dat.rateC);
			$('.lTwoSpan').css('height', dat.rateD);
			$('.lOwnSpan').css('height', dat.rateE);

			$('#lFivePer').text(dat.percentA);
			$('#lFourPer').text(dat.percentB);
			$('#lTreePer').text(dat.percentC);
			$('#lTwoPer').text(dat.percentD);
			$('#lOwnPer').text(dat.percentE);

			switch (dat.highlight)
			{
				case 'A' :
					$('.lFiveSpan').addClass('lHighlight');
				 break;

				case 'B' :
					$('.lFourSpan').addClass('lHighlight');
				 break;

				case 'C' :
					$('.lThreeSpan').addClass('lHighlight');
				 break;

				case 'D' :
					$('.lTwoSpan').addClass('lHighlight');
				 break;

				case 'E' :
					$('.lOwnSpan').addClass('lHighlight');
				 break;
			}
		}
		else
		{
			$('#lReviewScoreWrap').css('display', 'none');

		}
	});
}
/*-----------------------------------------------------------------
	프리미엄 구매후기
	send	: itemNo(상품번호), sz (페이지당 표시개수), pg (현재 페이지), total (총개수)
	get		: score(만족도), review(내용), reply(답변), writeId(작성자id), date(작성일), own(댓글소유권한)
-----------------------------------------------------------------*/
var drawPremiumReviewTbody	= function()
{
	var getTbody	= $("#lPremiumReviewTbl > tbody");

	// 이미지 mirror cfg
	var imageLinkMirror	= 'https://cdn1.domeggook.com';

	$.ajax({
		url			: "/main/item/itemView/reviewAjax.php",
		method		: "GET",
		data		: {"mode":"premium","itemNo": 60519599, "total": 0},
		dataType	: "json"
	}).done(function(dat){
		if(dat.length)
		{
			// 프리미엄 구매후기 보여주기
			var pr_header 			= document.querySelector('#lPremiumHeader');
			pr_header.style.display = 'block';


			// 구매후기 tbody 초기화
			getTbody.empty();

			// 구매후기 obj
			var titleTr,titleTd1, star,info;
			var contentTr,contentTd1, img_cnt,imgList,reply,modal,modalBody,modalBtn,swiperBtn,swiper1,swiper2;
			var pr_cnt = 0;

			// 구매후기 draw
			for(var i in dat)
			{
				/*---------------------------------
					첫번째 tr
				-------------------------------- */

				// 구매후기 상단
				titleTr		= $('<tr>');
				titleTd1	= $('<td class="lTitle">');		

				if(dat[i].score == 'A')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/>');
				}
				else if(dat[i].score == 'B')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}
				else if(dat[i].score == 'C')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}
				else if(dat[i].score == 'D')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}
				else if(dat[i].score == 'E')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}

				info		= $('<div>'+ dat[i].writeId +'</div><div>' + dat[i].date + '</div><img src='+imageLinkMirror+'/image/item/view/ico_best.png style="width:40px;vertical-align: top;"/>');		

				titleTd1.append(star);
				titleTd1.append(info);

				titleTr.append(titleTd1);
				/*---------------------------------
					두번째 tr
				-------------------------------- */
				contentTr	= $('<tr>');
				contentTd1	= $('<td class="lContents">');		

				if(dat[i].files)
				{
					img_cnt 			= 0;
					imgList 	= '';
					modal 		= $('<div class="modal lPremiumReview'+ pr_cnt + '" style="display:none;">');
					modalBody	= $('<div class="modal_body">');
					swiperBtn 	= '<div class="swiper-button-next swiper-button-white"></div><div class="swiper-button-prev swiper-button-white"></div>';
					swiper1		= '<div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper pr_swiperTop"><div class="swiper-wrapper">';
					swiper2		= '<div thumbsSlider="" class="swiper pr_swiperThumbs"><div class="swiper-wrapper">';
					modalBtn	= '<div class="modal_del" onclick="closeModal(this)"><img src="' + imageLinkMirror + '/image/item/view/btn_close.png" /></div>';

					for(var j in dat[i].files)
					{
						imgList += '<a href="javascript:showPremiumModal('+ pr_cnt +','+ img_cnt + ');">';
						imgList += '<img src="' + dat[i].files[j].url_660 +'" class="lMiniImg"/></a>';

						img_cnt++;
					}

					imgList += '<br>';
					contentTd1.append(imgList);

					// 모달 시작
					modalBody.append(swiperBtn);
					
					// 모달 그려주기
					for(var j in dat[i].files)
					{
						swiper1 += '<div class="swiper-slide">';
						swiper1 += '<img src="' + dat[i].files[j].url_1000 +'"/>';
						swiper1 += '</div>';

						swiper2 += '<div class="swiper-slide">';
						swiper2 += '<img src="' + dat[i].files[j].url_660 +'"/>';
						swiper2 += '</div>';
					}

					modalBody.append(swiper1);
					modalBody.append(swiper2);
					modalBody.append(modalBtn);

					modal.append(modalBody);
					
					contentTd1.append(modal);	
					// 모달 끝
					pr_cnt++;
				}

				contentTd1.append(dat[i].review);

				if(dat[i].reply)
				{
					reply = '<div class="lReply"><div class="lReplyDiv"></div><span class="lIcoSeller">공급사댓글</span><br>';
					reply += dat[i].reply;
					reply += '</div>';

					contentTd1.append(reply);
				}

				contentTr.append(contentTd1);

				getTbody.append(titleTr);
				getTbody.append(contentTr);

			}
		}
		else
		{
			//do nothing
		}

		// 모달슬라이더에 고유 클래스명 추가(swiper initializer를 위함)
		const pr_swiperTop = document.querySelectorAll('.pr_swiperTop');
		const pr_swiperThumbs = document.querySelectorAll('.pr_swiperThumbs');

		for (i = 0; i < pr_swiperTop.length; i++) 
		{
			pr_swiperTop[i].classList.add('pr-gallery-top-' + i);
			pr_swiperThumbs[i].classList.add('pr-thumbs-class-' + i);
		}
	});
}
/*-----------------------------------------------------------------
	구매후기
	send	: itemNo(상품번호), sz (페이지당 표시개수), pg (현재 페이지), total (총개수)
	get		: score(만족도), review(내용), reply(답변), writeId(작성자id), date(작성일), own(댓글소유권한)
-----------------------------------------------------------------*/
var drawReviewTbody	= function(pg)
{
	var getTbody	= $("#lReviewTbl > tbody");
	var getPgWrap	= $("#lReviewPage");

	// 이미지 mirror cfg
	var imageLinkMirror	= 'https://cdn1.domeggook.com';

	var pgMax		= Math.ceil(0/10);

	pg = pg || 1;
	pg = pg.toString().replace(/[^0-9]/g, '') || 1;
	pg = parseInt(pg, 10);
	pg = Math.max(pg, 1);
	pg = Math.min(pgMax, pg);

	// 페이지네이션을 그리기위해 사전계산
	var pgStart		= Math.max(Math.min(pg-4, pgMax-9), 1);

	if(pg < pgMax)
	{
		var nPg	= pg + 1;
	}

	$.ajax({
		url			: "/main/item/itemView/reviewAjax.php",
		method		: "GET",
		data		: {"mode":"review","itemNo": 60519599, "sz": 10, "total": 0, "pg": pg, "nPg": nPg},
		dataType	: "json"
	}).done(function(dat){
		if(dat.length)
		{
			// 구매후기 tbody 초기화
			getTbody.empty();

			// 구매후기 obj
			var titleTr,titleTd1, star,info;
			var contentTr,contentTd1, img_cnt,imgList,reply,delBtn,modal,modalBody,modalBtn,swiperBtn,swiper1,swiper2,fileUrl660,fileUrl1000;
			var cnt = 0;

			// 구매후기 draw
			for(var i in dat)
			{
				/*---------------------------------
					첫번째 tr
				-------------------------------- */

				// 구매후기 상단
				titleTr		= $('<tr>');
				titleTd1	= $('<td class="lTitle">');		

				if(dat[i].score == 'A')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/>');
				}
				else if(dat[i].score == 'B')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}
				else if(dat[i].score == 'C')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}
				else if(dat[i].score == 'D')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}
				else if(dat[i].score == 'E')
				{
					star	= $('<img src="' + imageLinkMirror + '/image/item/view/ico_starOn.png" width="13" height="12" alt="찬별" title="찬별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/><img src="' + imageLinkMirror + '/image/item/view/ico_starOff.png" width="13" height="12" alt="빈별" title="빈별"/>');
				}

				if(dat[i].isPremium == 't')
				{
					info		= $('<div>'+ dat[i].writeId +'</div><div>' + dat[i].date + '</div><img src='+imageLinkMirror+'/image/item/view/ico_best.png style="width:40px;vertical-align: top;margin-right:5px"/>');
				}
				else
				{
					info		= $('<div>'+ dat[i].writeId +'</div><div>' + dat[i].date + '</div>');
				}

				titleTd1.append(star);
				titleTd1.append(info);

				if(dat[i].own && dat[i].isPremium == 'f')
				{
					delBtn		= $('<div class="lDeleteBtn" data-no="'+ dat[i].no +'" onclick="delReview(this,'+pg+')">삭제</div>');
					
					titleTd1.append(delBtn);
				}
				

				titleTr.append(titleTd1);
				/*---------------------------------
					두번째 tr
				-------------------------------- */
				contentTr	= $('<tr>');
				contentTd1	= $('<td class="lContents">');		

				if(dat[i].files)
				{
					img_cnt 			= 0;
					imgList 	= '';
					modal 		= $('<div class="modal lReview'+ cnt + '" style="display:none;">');
					modalBody	= $('<div class="modal_body">');
					swiperBtn 	= '<div class="swiper-button-next swiper-button-white"></div><div class="swiper-button-prev swiper-button-white"></div>';
					swiper1		= '<div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper swiperTop"><div class="swiper-wrapper">';
					swiper2		= '<div thumbsSlider="" class="swiper swiperThumbs"><div class="swiper-wrapper">';
					modalBtn	= '<div class="modal_del" onclick="closeModal(this)"><img src="' + imageLinkMirror + '/image/item/view/btn_close.png" /></div>';


					for(var j in dat[i].files)
					{
						imgList += '<a href="javascript:showModal('+ cnt +','+ img_cnt + ');">';
						imgList += '<img src="' + dat[i].files[j].url_660 +'" class="lMiniImg"/></a>';

						img_cnt++;
					}

					imgList += '<br>';
					contentTd1.append(imgList);

					// 모달 시작
					modalBody.append(swiperBtn);
					
					// 모달 그려주기
					for(var j in dat[i].files)
					{
						swiper1 += '<div class="swiper-slide">';
						swiper1 += '<img src="' + dat[i].files[j].url_1000 +'"/>';
						swiper1 += '</div>';

						swiper2 += '<div class="swiper-slide">';
						swiper2 += '<img src="' + dat[i].files[j].url_660 +'"/>';
						swiper2 += '</div>';
					}

					modalBody.append(swiper1);
					modalBody.append(swiper2);
					modalBody.append(modalBtn);

					modal.append(modalBody);

					contentTd1.append(modal);	
					// 모달 끝
					cnt++;
				}

				contentTd1.append(dat[i].review ? dat[i].review : '&nbsp;');

				if(dat[i].reply)
				{
					reply = '<div class="lReply"><div class="lReplyDiv"></div><span class="lIcoSeller">공급사댓글</span><br>';
					reply += dat[i].reply;
					reply += '</div>';

					contentTd1.append(reply);
				}

				contentTr.append(contentTd1);

				getTbody.append(titleTr);
				getTbody.append(contentTr);
			}

			// 페이지네이션 초기화
			getPgWrap.empty();

			// 페이지네이션 draw
			var anc, pgOl, pgLi;

			// 이전 10페이지 이동
			if(pg>10)
			{
				anc	= $('<a href="javascript:drawReviewTbody(' + (pg-10) + ')" class="btn bf10">10페이지 전</a>');
				getPgWrap.append(anc);
			}

			// 이전 1페이지 이동
			if(pg>1)
			{
				anc	= $('<a href="javascript:drawReviewTbody(' + (pg-1) + ')" class="btn bf1">1페이지 전</a>');
				getPgWrap.append(anc);
			}

			// 페이지리스트
			pgOl	= $('<ol>');

			for(var i=0; i<10; i++)
			{
				var p	= pgStart+i;

				pgLi	= $('<li target=' + p + '>');

				if(p==pg)
				{
					pgLi.attr('class', 'curr');
				}

				anc	= $('<a href="javascript:drawReviewTbody(' + p + ')">' + p + '</a>');

				pgLi.append(anc);
				pgOl.append(pgLi);

				if(p >= pgMax)
				{
					break;
				}
			}

			getPgWrap.append(pgOl);

			// 이후 1페이지 이동
			if(pg+1 <= pgMax)
			{
				anc	= $('<a href="javascript:drawReviewTbody(' + (pg+1) + ')" class="btn af1">1페이지 후</a>');
				getPgWrap.append(anc);
			}

			// 이후 10페이지 이동
			if(pg+10 <= pgMax)
			{
				anc	= $('<a href="javascript:drawReviewTbody(' + (pg+10) + ')" class="btn af10">10페이지 후</a>');
				getPgWrap.append(anc);
			}

			// 이동 input draw
			var divObj, inputObj1, inputObj2, spanObj;

			divObj	= $('<div id="lReviewPageInputs">');

			inputObj1	= $('<input type="text" id="lReviewPgInput" value="' + pg + '"/>');
			inputObj2	= $('<input type="button" value="이동" onclick="drawReviewTbody(document.getElementById(\'lReviewPgInput\').value)"/>');

			spanObj	= $('<span>총 <b>' + pgMax + '</b>페이지</span>');

			divObj.append(inputObj1);
			divObj.append(inputObj2);
			divObj.append(spanObj);
			getPgWrap.append(divObj);
		}
		else
		{
			// 구매후기 tbody 초기화
			getTbody.empty();

			// 구매후기 tbody에 채워넣을 값 담을 obj
			var trObj, td1Obj, td2Obj, td3Obj, td4Obj, td5Obj;

			trObj	= $('<tr>');
			td1Obj	= $('<td colspan="5"><div id="lNoReviewWrap"><img src="' + imageLinkMirror + '/image/common/img_exclamationMark.png" width="40" height="40" alt="느낌표" title="느낌표"><b>아직 등록된 구매후기가 없습니다<b></td>');

			trObj.append(td1Obj);
			getTbody.append(trObj);
		}

		// 상품상세페이지 내에서 엘리먼트의 높이가 달라진 경우 실행할 콜백
		lItemViewRedrawed('review');

		// 슬라이더 이름에 고유 클래스명 추가	
		const swiperTop = document.querySelectorAll('.swiperTop');	
		const swiperThumbs = document.querySelectorAll('.swiperThumbs');	
		for (i = 0; i < swiperTop.length; i++) 	
		{	
			swiperTop[i].classList.add('gallery-top-' + i);	
			swiperThumbs[i].classList.add('thumbs-class-' + i);	
		}

}).fail(function(dat){});
}
</script>

