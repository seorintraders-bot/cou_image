			top					: 3px;
			left				: 3px;
			width				: 15px;
			height				: 15px;
		}


		/*-----------------------------------------------------------------
		탭 내용
		-----------------------------------------------------------------*/
		.lInfoBody
		{
			display				: none;
			width				: 100%;
		}
		.lInfoBody.lSelected
		{
			display				: block;
		}
		.lInfoBody table
		{
			table-layout		: auto;
			border-collapse		: collapse;
		}
		.lInfoBody table > tbody > tr > th,
		.lInfoBody table > tbody > tr > td
		{
			padding				: 22px 0 0 0;
			min-height			: 24px;
			text-align			: left;
			letter-spacing		: -1px;
			vertical-align		: top;
		}
		.lInfoBody table label
		{
			display				: block;
			margin-top			: 25px;
			padding				: 3px 0;
			height				: 18px;
			font-size			: 16px;
			font-weight			: normal;
			color				: #1B1B1B;
			vertical-align		: middle;
		}
		.lInfoBody table > tbody > tr > th
		{
			padding-right		: 15px;
			font-size			: 16px;
			font-weight			: normal;
			color				: #1B1B1B;
			white-space			: nowrap;
		}
		.lInfoBody table > tbody > tr > td
		{
			position			: relative;
			/*width				: 475px;*/
			padding-right		: 5px;
			font-size			: 16px;
			color				: #1B1B1B;
		}
		.lInfoBody table > tbody > tr > td[colspan="2"]
		{
			width				: 588px;
			padding-top			: 0;
		}



		/* body - 공통 */
