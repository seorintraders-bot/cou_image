<!-- 상품상세페이지 공통 스크립트 -->
<script type="text/javascript">
	/*-----------------------------------------------------------------
	상품상세페이지 데이터 관리 모듈
	- dispatch 메소드로 데이터를 변경하면 subscribe로 등록한 콜백 메소드를 실행하는 구조
	-----------------------------------------------------------------*/
	window.lItem = {};
	window.lItem.store = (function(){
		var obj = {
			// 상태 데이터
			state: {
				// 현재 선택된 도매/배송대행 탭
				market		: 'supply',

				// 도매 - 현재 구매수량이 속한 기준단가 (초기값은 판매단가)
				baseAmtDome	: 1500,

				// 도매 - 현재 구매수량이 속한 기준단가의 idx
				// 0 : 샘플단가
				// 1 : 판매단가 또는 수량별할인단가 첫번째 구역
				// 2 ~ : 수량별할인단가 구역)
				baseAmtDomeIdx	: 1,

				// 배송결제선택
				dwDome		: '',	// 도매
				dwSupply	: ''	// 배송대행
			},

			// 과거 데이터
			prevState: {},

			// 구독중인 callback 목록
			subscribers: {},

			// store의 데이터 변경 구독하기
			subscribe: function(actionType, callback)
			{
				this.subscribers[actionType] = this.subscribers[actionType] || [];
				this.subscribers[actionType].push(callback);
			},

			// store의 데이터 변경
			// action = {type : '', market : ''}
			dispatch: function(action)
			{
				// action 실행
				switch(action.type) {
					// market 데이터 변경
					case 'SET_MARKET':
						this.setState({
							market: action.market
						})
						break;
					
					// 상품단가 기준 변경
					case 'SET_BASE_AMT_DOME':
						this.setState({
							baseAmtDome: action.baseAmtDome,
							baseAmtDomeIdx: action.baseAmtDomeIdx
						})
						break;

					// 배송결제선택 변경
					case 'SET_DW_DOME':
						this.setState({
							dwDome: action.dwDome
						})
						break;

					// 배송결제선택 변경
					case 'SET_DW_SUPPLY':
						this.setState({
							dwSupply: action.dwSupply
						})
						break;

					default:
						// callback 실행안함
						return;
				}

				// 구독중인 callback 실행
				this.callSubscribers(action.type);
			},

			// 내부 state 데이터 변경
			setState: function(obj)
			{
				var key;
				
				// 과거 데이터에 현재 데이터 복사
				this.setPrevState();

				// 현재 데이터 변경
				for(key in obj)
				{
					if(this.state.hasOwnProperty(key))
					{
						this.state[key] = obj[key];
					}
				}
			},

			// 과거 데이터에 현재 데이터 복사
			setPrevState: function()
			{
				var stateStr;
				
				stateStr = JSON.stringify(this.state);
				this.prevState = JSON.parse(stateStr);
			},

			getState: function()
			{
				return this.state;
			},

			// 구독중인 callback 메소드 실행
			callSubscribers: function(actionType)
			{
				var i,
					subscribers = this.subscribers[actionType];
				
				if(subscribers)
				{
					for(i = 0; i < subscribers.length; i++)
					{
						// 구독자에게 새로운 데이터, 과거 데이터, action type을 전달
						subscribers[i](this.state, this.prevState, actionType);
					}
				}
			}
		}

		// 과거 데이터 생성
		obj.setPrevState();

		return obj;
	})();

	
	/*-----------------------------------------------------------------
	상품상세페이지 공통 - 테이블 레이어(.lItemViewLayer)
	-----------------------------------------------------------------*/
	// 테이블 레이어 닫기 버튼
	$('#itemView').on('click', '.lItemViewLayer .lBtnCloseLayer', function(){
		var target = $(this).parents('.lItemViewLayer');
		target.removeClass('lShown')
	})
</script><div id="lItemViewTop"><div id="lPath">
