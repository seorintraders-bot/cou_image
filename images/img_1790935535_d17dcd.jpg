<script>
	function searchBox(o,se)
	{
		$("#searchView").html(o.innerHTML);
		$("input[name='sf']").val(se);

		$('ul.s_index_select_ul').hide();
	}

	function number_format(num)
	{
		return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
	}

	function dispCateNav(m)
	{
		if(m == 1)
		{
			$('div#categoryNav').css('display', 'block');
		}
		else
		{
			$('div#categoryNav').css('display', 'none');
		}
	}
</script>


		 

<script>
// 알림목록 팝업 열기 
function openAlimList() 
{
	var alimUrl = "";

	if(alimUrl)
	{        
		var left = Math.round(window.screenX + (window.outerWidth/2) - 250);
		var top = Math.round(window.screenY + (window.outerHeight/2) - 500);

//		var alimList = window.open("", 'popupChkPlus', 'width=500, height=1000, top=' + top + ', left=' + left + ', fullscreen=no, menubar=no, status=no, toolbar=no, titlebar=yes, location=no, scrollbar=no');
//		alimList.location.href = alimUrl;

		window.open(alimUrl, 'popupChkPlus', 'width=500, height=1000, top=' + top + ', left=' + left + ', fullscreen=no, menubar=no, status=no, toolbar=no, titlebar=yes, location=no, scrollbar=no');

		// 새알림 플래그 0처리
		document.cookie = "ngm_new_message=0; path=/;";

		// new tag 삭제
		var newTag = document.querySelector('img.msgNew');

		if (newTag) 
		{
			newTag.remove();
		}
	}
}
</script> 
