<script>
	function setLoginFloatWin()
	{
		var isIE6 = (navigator.userAgent.indexOf('MSIE 6') > 0);
		var wrap = document.getElementById('loginCoverScr');
		var back = document.getElementById('loginFloatBack');
		var win	 = document.getElementById('loginFloatWin');

		var browserHeight = window.innerHeight? window.innerHeight: document.documentElement.clientHeight;

		if (isIE6)
		{
			wrap.style.position	= 'absolute';
			wrap.style.height	= document.body.clientHeight + 'px';
			back.style.position	= 'absolute';
			back.style.height	= document.body.clientHeight + 'px';
		}
		else
		{
			wrap.style.height	= Math.max(screen.availWidth, screen.availHeight) + 'px';
			back.style.height	= Math.max(screen.availWidth, screen.availHeight) + 'px';
		}
		win.style.top		= (browserHeight - 570) / 2 + 'px';
		win.style.display	= 'block';
	}

	function floatLoginKeyDown(e)
	{
		var evt = e? e: event;
		var keyCode = evt.keyCode;

		if(keyCode == 13)
		{
			var frm = document.getElementById('frmFloatLogin');

			if(chkLogin(frm))
			{
				frm.submit();
			}
		}
	}
	setLoginFloatWin();
	document.body.onresize = setLoginFloatWin;
	document.getElementById('frmFloatLogin').id.onkeydown = floatLoginKeyDown;
	document.getElementById('frmFloatLogin').pass.onkeydown = floatLoginKeyDown;
</script>

