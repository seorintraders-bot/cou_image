<script type="text/javascript">

	// 상품상세설명 삭제
	function lInfoViewSubDel(no, itemNo)
	{
		if(confirm('추가 된 내용을 삭제 하겠습니까?'))
		{
			location.href = '/main/item/itemIng.php?mode=delCom&no='+no+'&mother='+itemNo;
		}
	}

	// 상품상세설명 등록
	function lInfoViewSubMemoReg()
	{
		var subMemo = document.getElementById("subMemo");

		var subMemoVal = trim(subMemo.value);

		var memoWords = "상품상세설명 추가하기(상품과 관련 없는 광고성문구, HTML 입력 불가)";

		if(memoWords != subMemoVal && subMemoVal)
		{
			var msg = '사이트 광고나 개인 연락처, 직거래 유도 등이 문구 포함시 상품등록 제재 및 회원자격이 정지될 수 있습니다. 위 사항에 동의 하겠습니까?';

			if(!confirm(msg))
			{
				return false;
			}
		}
		else
		{
			alert('상품상세설명을 입력하세요');
			subMemo.focus();
			return false;
		}

		return true;
	}

	// 상품상세설명 textarea 구현
	function lInfoViewSubMemo(obj)
	{
		var memoWords = "상품상세설명 추가하기(상품과 관련 없는 광고성문구, HTML 입력 불가)";

		if(memoWords == trim(obj.value))
		{
			obj.value = '';
		}
		else if(!trim(obj.value))
		{
			obj.value = memoWords;
		}
	}

	function lowestPriceContUlTab(obj, type)
	{
		$('.lowestPriceContUlTab').find('li').removeClass("selected");
		$(obj).addClass("selected");

		if(type == 'org')
		{
			$('#lInfoViewItemContents').show();
			$('#lInfoViewReItemContents').hide();
		}
		else if(type == 're')
		{
			$('#lInfoViewItemContents').hide();
			$('#lInfoViewReItemContents').show();
		}
	}

	function infoImgDownloadSubmit()
	{
		$("#infoImgDownloadFrm").submit();
	}

	function ocrAjax()
	{
		var itemNo = "60519599";
		
		 $.ajax({
            url: "/main/item/itemView/ocrGoodInfoAjax.php",
            type: "GET",
            data: "no="+itemNo,
            dataType: "json"
        })
        .done(function(content)
        {
            let listHtml = '';
			
			if(content.result == true)
			{	
				listHtml +=  '<div class="ocrTitle"><span class="ocrSubTtile1">꾹AI:</span>'
								+ '상품정보 요약<span class="subImg"><img src="https://cdn1.domeggook.com/image/mobile_v2/image/item/view/ico_beta.png"/></span>'
								+ '<span class="ocrSubTtile2">상세 페이지의 정보를 AI로 분석한 내용입니다.</span></div>'
								+'<div class="ocrTblWrap">';
				$('#ocrAiInfo').show();
				

				// ocr 결과값뿌리기
				for(idx in content.data)
                {
					listHtml += '<div class="lCell">'
								+'<label class="tableCell aiLabel">'+idx+'</label><div class="tableCell">'+content.data[idx]+'</div>'
								+'</div>';
				}
				listHtml+= '</div>';
				
				listHtml+= '<div class="ocrSubTtile2">상세 페이지의 정보를 AI로 분석한 내용이므로, 실제 상품 정보는 상품 상세 페이지를 꼭 확인해주세요!</div>';
				$('#ocrAiInfo').prepend(listHtml);
				return true;

			}
			else
			{
				$('#ocrAiInfo').hide();
				return false;
			}
        })
        .fail(function(){
            $('#ocrAiInfo').hide();
			return false;
        });
	}

	function funcMdClickCntFunc(bannerNo)
	{
		//alert('클림됨');
		 $.ajax({
			url: "/main/item/itemView/mdAdvClickAjax.php",
			type: "GET",
			data: "bnrName=shopCategoryBnr2025&no="+bannerNo+"&from=itemView",
			dataType: "json"
		})
		.done(function(content)
        {
			if(content.res == true)
			{
				// api성공. 클릭수치 올라감
				return true;
			}
			else // content.res == false
			{
				//alert(content.msg); (클라이언트에 에러메세지 띄우는게 의미없어서 안띄움. 클릭수치 안올라가는것으로 끝.)
				return false;
			}
		})
		.fail(function(){
				return false;
        });
	}

	

	$(function(){
		// 교정 후 이미지 다운로드 도움말
		var hideTimer;

		function hideTip()
		{
			$("#lInfoViewDownloadBtnWrap").removeClass("showTip");
		}

		$("#lInfoViewDownloadTipIco").add($("#lInfoViewDownloadTipText"))
			.bind("mouseenter", function(){
				clearTimeout(hideTimer);
				$("#lInfoViewDownloadBtnWrap").addClass("showTip");
			})
			.bind("mouseleave", function(){
				hideTimer = setTimeout(hideTip, 1000);
			});
	});

</script>

	

	</div>
	<div id="lInfoView">
		
		<div id="ocrAiInfo">
		</div>

		<div class="lNoDirectDealingWrap">	
