			right				: 5px;
			text-align			: right;
		}
		#lInfoWrap #lInfoTab .lBtnWrap .lBtn
		{
			display				: inline-block;
			margin-left			: 12px;
			height				: auto;
			width				: auto;
			border				: none;
			font-size			: 0;
		}
		#lInfoWrap #lInfoTab .lBtnWrap .lBtn:first-child
		{
			margin-left			: 0;
		}
		#lInfoWrap #lInfoTab .lBtnWrap .lBtn button
		{
			height				: 24px;
			width				: auto;
			padding-right		: 10px;
