							<div class="lGGookDealCouponBtn subBtn">
								<div class="box1">
									<img class="img1" src="https://cdn1.domeggook.com/image/event/ggookDeal/couponDealPercent.png" />
									<span> 쿠폰받기</span>
									<img class="img2" src="https://cdn1.domeggook.com/image/event/ggookDeal/downloadArrow_red.png" />
								</div>
							</div>
						</td>
					</tr>
					<!-- 장바구니/구매 버튼 -->
					<tr id="lOptFooter" class="supply">
						<td>
																					<button id="lOptBtnCart" class="lOptBtnFooter" onclick="onPayBtnClick('CART', 'side'); return false">장바구니</button>
							<button id="lOptBtnBuy" class="lOptBtnFooter" onclick="onPayBtnClick('ORDER'); return false">구매하기</button>
													</td>
					</tr>
				</tbody>
			</table>
		</div><!-- end of #lStickyOptFix -->
	</div><!-- end of #lStickyOpt -->

</div>

<script>
	// 탭 및 옵션 UI 상단 고정 기능
	$(function(){

		// 상속
		var lExtends = function(parentConstructor, childConstructor)
		{
			var Ghost = function(){};
			Ghost.prototype = parentConstructor.prototype;

			childConstructor.prototype = new Ghost();
		}


		/*-----------------------------------------------------------------
		Sticky 부모 모듈
		-----------------------------------------------------------------*/
		var StickyProto = function(args)
		{
			// 초기화
			this._init(args);
		};

		StickyProto.prototype = {
			_win: $(window),
			_doc: $(document),
			_callback: {
				init: [],
				resize: [],
				scroll: []
			},
			_scrollTop: 0,	// scroll 위치
			_winHeight: 0,	// 브라우저 높이

			// 레이아웃이 fixed로 변경되는 기준 위치 계산
			setFixedPoint: function(debug)
			{
				var inst = this;

				inst._fixedTopStart = inst._elStart.offset().top;

				if(inst._elEnd)
				{
					inst._fixedTopEnd = inst._elEnd.offset().top - inst._winHeight;
				}

				inst._drawView(debug);
			},

			// 초기화
			_init: function(args)
			{
				var inst = this;

				this._elFix			= args.elFix;		// Fixed로 고정되는 엘리먼트
				this._elStart		= args.elStart;		// Fixed 고정이 시작되는 기준이 될 엘리먼트 (브라우저에 이 엘리먼트가 보이기 시작하면 Fixed 고정 시작)
				this._elEnd			= args.elEnd;		// Fixed 고정이 끝나는 기준이 될 엘리먼트 (브라우저에 이 엘리먼트가 보이기 시작하면 Fixed 고정 끝)
				this._fixedTopStart	= null;				// Fixed 고정이 시작되는 scrollTop
				this._fixedTopEnd	= null;				// Fixed 고정이 끝나는 scrollTop
				this._mode			= '';				// 옵션 UI 고정 상태 (Absolute || Fixed)
				this._winHeight 	= this._win.innerHeight();

				this._setCallback(args.callback, 'init');
				this._setCallback(args.callback, 'resize');
				this._setCallback(args.callback, 'scroll');
				this._callbackLoad	= args.callback.load;	// 브라우저 로딩이 끝난 후 실행할 콜백

				// 이벤트 추가
				this._addEvent();

				setTimeout(function(){
					// init 콜백 실행
					inst._runCallback('init')
				}, 0);
			},

			// drawing callback
			_raf: function(callback){
				var raf = window.requestAnimationFrame || window.setImmediate || function(c) { return setTimeout(c, 0); };
				raf(callback);
			},

			// 이벤트 콜백 설정
			_setCallback: function(callback, key)
			{
				var i;

				if(!callback || !callback[key])
				{
					return;
				}

				this._callback[key].push(callback[key]);
			},

			// 이벤트 콜백 실행
			_runCallback: function(callbackKey)
			{
				var i, callbackArr;

				callbackArr = this._callback[callbackKey];

				if(!callbackArr || !callbackArr.length)
				{
					return;
				}

				for(i = 0; i < callbackArr.length; i++)
				{
					callbackArr[i](this);
				}
			},

			// 이벤트 추가
			_addEvent: function()
			{
				var inst = this;

				// 브라우저 리사이즈 이벤트
				this._win.on('resize', function(){

					inst._winHeight = inst._win.innerHeight(); // 브라우저 사이즈가 변경될때마다 높이 재측정

					// 브라우저 높이가 변경되므로 Fixed 기준점 측정
					inst.setFixedPoint();

					// 이벤트 콜백 실행
					inst._raf(function(){
						inst._runCallback('resize')
					});
				})

				// 브라우저 스크롤 이벤트
				this._win.on('scroll', function(){
					// scrollTop 업데이트
					inst._scrollTop = inst._doc.scrollTop();

					inst._drawView();

					// 이벤트 콜백 실행
					inst._raf(function(){
						inst._runCallback('scroll')
					})
				})

				// 브라우저의 모든 리소스(이미지 포함) 로딩이 끝난 후
				this._win.on('load', function(){
					inst._scrollTop = inst._doc.scrollTop();

					// fixed 기준점 계산
					inst.setFixedPoint('load'); // 모든 리소스 로딩이 끝난 후 위치 계산

					inst._callbackLoad && inst._callbackLoad(inst);
				})
			},

			// 엘리먼트 View 변경
			// 스크롤 위치에 따라 엘리먼트의 고정 상태 변경
			_drawView: function(debug)
			{

				// 아직 fixedTop이 설정되지 않은 경우 리턴
				if(this._fixedTopStart === null)
				{
					return;
				}

				// 시작 지점 아래로 스크롤 된 경우
				try
				{
					if(this._scrollTop > this._fixedTopStart)
					{
						if(this._mode === 'Fixed')
						{
							throw '';
						}

						this._mode = 'Fixed';
					}
					// 스크롤이 시작 지점보다 위에 있는 경우
					else
					{
						if(this._mode === 'Absolute')
						{
							throw '';
						}

						this._mode = 'Absolute';
					}

					// mode값이 바뀐 경우에만 클래스 변경
					this._mode === 'Fixed' ? this._elFix.addClass('lFixed') : this._elFix.removeClass('lFixed');
				}
				catch(e)
				{

				}

				this._checkFixedEnd();
			},

			// Fixed가 끝나는 지점보다 아래로 스크롤된 경우에는 Fixed엘리먼트를 화면 위로 올림
			_checkFixedEnd: function()
			{
				var top;

				if(!this._fixedTopEnd)
				{
					return;
				}

				// 끝 지점 아래로 스크롤 된 경우
				if(this._scrollTop > this._fixedTopEnd)
				{
					top = this._scrollTop - this._fixedTopEnd;
				}
				else
				{
					top = 0;
				}

				this._elFix.css('top', -top);
			}
		};


		/*-----------------------------------------------------------------
		탭(Tab) 레이아웃(StickyProto 상속)
		-----------------------------------------------------------------*/
		var StickyTabController = function()
		{
			var _inst = this;

			this.tabIdx = 0;			// 현재 선택된 탭 index
			this.tabTopList = [];		// 각 탭의 top 위치 목록
			this.elStickyTabList = $('#lStickyTabList');
			this.elItemViewBottom = $('#lItemViewBottom');
			this.fixedUIHeight = 51;	// fixed로 고정된 tab UI의 높이
			this.topOffset = 50;		// 각 탭의 top 위치에 50px 여유 추가
			this.lastTabThreshold = 0; // scroll 위치가 threshold를 넘어가면 무조건 마지막 탭 선택
			this.isTabAnimating = false;

			// StickyProto 변수 상속
			StickyProto.call(this, {
				elFix		: $('#lStickyTab'),			// fixed로 고정할 엘리먼트
				elStart		: $('#lItemViewBody'),		// fixed가 시작될 기준이되는 엘리먼트
				// elEnd		: $('#lItemViewBottom'),	// fixed가 끝날 기준이되는 엘리먼트
				showAfterLoad: true,
				callback	: {
					// 스크롤 할때마다 실행할 콜백
					scroll: function(){
						
						if(_inst.isTabAnimating)
						{
							return ;
						}

						_setTabByScrollTop();
						_drawTab();
					},
					load: function(){
						_inst.setTabTop('win load'); // 모든 로딩이 끝난 후 탭의 위치 다시 계산
						_setTabByScrollTop();
						_drawTab();

						setTimeout(function(){
							_inst.setTabTop('init + 300ms');
							_setTabByScrollTop();
							_drawTab();
						}, 300);

						setTimeout(function(){
							_inst.setTabTop('init + 1000ms');
							_setTabByScrollTop();
							_drawTab();
						}, 1000);
					}
				}
			});

			// 각 탭의 위치 계산
			this.setTabTop = function(debug)
			{
				var i, tab, offset;

				for(i = 0; i < _inst.tabTopList.length; i++)
				{
					tab = _inst.tabTopList[i];

					if(!tab.el.length)
					{
						continue;
					}

					offset = tab.el.offset();
					if(!offset)
					{
						continue;
					}

					tab.top = parseInt(offset.top - _inst.topOffset, 10);
				}
			};

			// init
			_init();

			function _init()
			{
				_inst.tabTopList = [
					{
						idx: 0,
						el: $('.lInfoViewSubWrap')	// 상세설명 이미지 사용여부
					},
					{
						idx: 1,
						el: $('#lReview')	// 구매후기
					},
					{
						idx: 2,
						el: $('#lSupport')	// 상품문의
					},
					{
						idx: 3,
						el: $('#lReturnGubun')	// 반품정보
					}
				];

				_inst.setTabTop('init');

				_inst.elStickyTabList.on('click', 'li', function(){
					
					// tab 클릭했을 때 재계산
					_inst.setTabTop('tab click');

					var idx = parseInt($(this).attr('data-idx'), 10);

					// scrollTop 설정
					var targetTab = _getTabByIdx(idx);

					if(!targetTab)
					{
						return false;
					}

					var scrollTop = targetTab.top;

					if(idx === 0)
					{
						scrollTop += _inst.topOffset;
					}

					scrollTop = Math.min(scrollTop, _getMaxScrollTop());

					_inst.isTabAnimating = true;
					_inst.tabIdx = idx;
					_drawTab();

					$('html, body').stop(true).animate({
						scrollTop: scrollTop
					}, 200, function(){
						_inst.isTabAnimating = false;
						_inst.setTabTop('tab animate end');
						_setTabByScrollTop();
						_drawTab();
					});
				});

				// 동적 콘텐츠 변경 상황에 대한 대응
				$(window).on('resize', function(){
					_inst.setTabTop('resize');
					_setTabByScrollTop();
					_drawTab();
				});
			}

			function _setTabByScrollTop()
			{
				var i, tab;
				var currentLine = _inst._scrollTop + _inst.fixedUIHeight + 1;
				var selectedIdx = 0;

				for(i = 0; i < _inst.tabTopList.length; i++)
				{
					tab = _inst.tabTopList[i];

					if(currentLine >= tab.top)
					{
						selectedIdx = tab.idx;
					}
					else
					{
						break;
					}
				}

				_inst.tabIdx = selectedIdx;

				// 문서 최하단 근처에서는 마지막 탭 우선
				if(_getMaxScrollTop() - _inst._scrollTop < 5)
				{
					_inst.tabIdx = 3;
				}
			}


			function _drawTab()
			{
				_inst.elStickyTabList.find('li')
					.removeClass('sel')
					.eq(_inst.tabIdx).addClass('sel')
			}

			function _getTabByIdx(idx)
			{
				var i; 

				for(i = 0; i < _inst.tabTopList.length; i++)
				{
					if(_inst.tabTopList[i].idx === idx)
					{
						return _inst.tabTopList[i];
					}
				}
				return null;
			}

			function _getMaxScrollTop()
			{
				return Math.max(0, $(document).height() - _inst._winHeight);
			}
		};


		/*-----------------------------------------------------------------
		옵션(Opt) 레이아웃(StickyProto 상속)
		-----------------------------------------------------------------*/
		var StickyOptController = function()
		{
			var _inst				= this,
				_elWrap				= $('#lStickyOpt'),
				_elOptQtyInput		= $('.lOptQtyInput'),	// 옵션을 사용하지 않을때 생성되는 수량선택 UI 엘리먼트
				_elPayCartNotice	= $('#lPayCartNotice'),	// 장바구니 메세지 토스트 UI
				_elOptTab			= $('#lOptTab'),
				_elOptBody			= $('#lOptBody .lOptBody[data-market]'),
				_elOptFooter		= $('#lOptFooter'),
				_elOptFooterTd		= $('#lOptFooter > td'),
				_optMarginLeft		= 0, 						// 하단 옵션 UI의 marginLeft 초기값
				_deliveryWho		= 'P',
				_elFixHeightTimeout = null;

			this.fixedUIHeight = 51;	// fixed로 고정된 tab UI의 높이


			// StickyProto 모듈 변수 상속
			StickyProto.call(this, {
				elFix		: $('#lStickyOptFix'),
				elStart		: $('#lItemViewBody'),
				elEnd		: $('#lItemViewBottom'),
				callback	: {
					// Fixed Layout의 초기화가 끝난 후 실행할 콜백
					init: function(){
						_copyNoOptElement()
						_setBottomHeight()
						_setBottomMarginLeft()
					},
					// 브라우저가 resize 될때마다 실행될 콜백
					resize: function(){
						_setBottomHeight({
							delay: 500
						})
					},
					// 브라우저 scroll 이벤트가 발생할때마다 실행할 콜백
					scroll: function(){
						_setBottomMarginLeft()
					},
					// 브라우저의 모든 리소스 로딩이 끝난 후
					load: function(inst)
					{
						_elWrap.removeClass('lHidden')
					}
				}
			});

			_init();

			// 옵션 엘리먼트 내부에서 외부와 상관없이 실행할 초기화 설정 (Fixed Layout과는 관련없음)
			function _init()
			{
				// 하단 옵션 UI의 marginLeft 초기값
				_optMarginLeft = 1200 / 2 - _inst._elFix.outerWidth();

				// 도매/배송대행 탭 상태 변경 구독
				window.lItem.store.subscribe('SET_MARKET', function(nextState, prevState){
					// 버튼 선택 상태 변경
					_elOptTab.find('.lBtn').removeClass('lSelected')
					_elOptTab.find('.lBtn[data-market=' + nextState.market + ']').addClass('lSelected')

					// 탭 내용 변경
					_elOptBody
						.removeClass('lShown')
						.filter('[data-market=' + nextState.market + ']').addClass('lShown')

					// 하단 footer 클래스 변경
					_elOptFooter[0].className = nextState.market;
				})

				// 도매/배송대행 탭 버튼 클릭 이벤트
				_elOptTab.on('click', '.lBtn', function(){
					var btn = $(this),
						market = btn.attr('data-market');

					// market 데이터 변경
					window.lItem.store.dispatch({
						type	: 'SET_MARKET',
						market	: market
					})
				})

				// 장바구니 메세지 UI 이동
				/* [TT-2436] 작업 중 ajax가 2번 호출 되는 문제로 인해 살펴보니, DOM을 쓸때없이 2번 그리는 작업으로 보여서 주석 처리하였습니다 
				혹시 이상이 있다면 이부분의 주석을 풀어 주세요.
				$('#lPayBtnCart').on('click', function(e){
					_elPayCartNotice.hide().appendTo('#lPayBtnWrap');
				})

				$('#lOptBtnCart').on('click', function(e){
					_elPayCartNotice.hide().appendTo(_elOptFooterTd);
				})
				*/
			}

			// UI 높이값 설정
			function _setBottomHeight(args)
			{
				var height;
				var delay = (args && args.delay) || 0;

				// UI 전체 높이 설정
				clearTimeout(_inst._elFixHeightTimeout);
				_inst._elFixHeightTimeout = setTimeout(function(){
					_inst._elFix.css('height', _inst._winHeight - _inst.fixedUIHeight); // Tab 높이만큼 제외
				}, delay);
			}

			// UI의 왼쪽 마진 설정
			// (브라우저에 가로 스크롤바가 가능한 경우 스크롤한 만큼 왼쪽마진에서 감소시켜야 위치가 정확해짐)
			function _setBottomMarginLeft()
			{
				var scrollLeft,
					newMarginLeft;

				if(_inst._mode === 'Absolute')
				{
					// asbolute 모드인경우 항상 고정값 사용
					newMarginLeft = _optMarginLeft;
				}
				else if(_inst._mode === 'Fixed')
				{
					// 브라우저의 가로 스크롤이 움직인 경우
					if(scrollLeft = _inst._doc.scrollLeft())
					{
						// 움직인 만큼 초기값에서 감소
						newMarginLeft = _optMarginLeft - scrollLeft;
					}
					// 브라우저 가로 크기가 엘리먼트 크기 이상인 경우
					else
					{
						// 초기값 고정
						newMarginLeft = _optMarginLeft;
					}
				}

				_elWrap.css('marginLeft', newMarginLeft)
			}

			// 옵션이 없을 경우 상단 엘리먼트 복사
			function _copyNoOptElement()
			{
				// 엘리먼트가 없으면 리턴
				if(!_elOptQtyInput.length)
				{
					return;
				}

				_elOptQtyInput.each(function(){
					var market = $(this).attr('data-market'),
						html;

					html = '<label>수량선택</label>' + this.outerHTML;

					$('.lOptBody[data-market=' + market + '] .lOptBodySel > td').html(html)
				})
			}
		};

		// 인스턴스 생성
		lExtends(StickyProto, StickyTabController); // StickyProto prototype 상속
		window.lItem.stickyTab = new StickyTabController();

		lExtends(StickyProto, StickyOptController); // StickyProto prototype 상속
		window.lItem.stickyOpt = new StickyOptController();

		// sticky 엘리먼트 위치 이동
		$('#lSticky').appendTo('#lItemViewBody')
		$('#lStickyTab').addClass('lShown')


		
	});

// 상품 상태에 따른 구매버튼 안보이게 처리
var itemStatus	   = "진행중";

if(itemStatus == '기간종료')
{
	$("#lStickyOpt").empty();
}

if(itemStatus == '판매종료')
{
	$("#lStickyOpt").empty();
}

if(itemStatus == '최소재고부족')
{
	$("#lOptTotalViewDome").empty();
	$("#lOptFooter").empty();
	$("#lOptFooter").append('<td><button class="lOptBtnFooter lDisabled">재고가 없는 상품입니다</button></td>');
}




</script>

<!-- 썸네일 오른쪽 가격정보 -->
<div id="lInfoWrap">
	<style>
		/* 공통 */
		#lInfoWrap
		{
			position			: relative;
			z-index				: 100;
			float				: right;
			width				: 588px;
			color				: #1B1B1B;
		}

