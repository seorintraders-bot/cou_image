		<!-- 상품설명 -->
		<div class="lInfoViewItemContents" id="lInfoViewItemContents">

			<!-- 상품 상세내용 -->
			
					<textarea id="contentsBuffer" style="display:none"><div style="text-align: center;"><img src="" border="0" style="font-size: 1em;"><img src="https://gi.esmplus.com/hheimish2/LM0542/LM-0542-0.jpg" border="0" style="font-size: 1em;"></div><!--SEP--><br><!--SEP--><br><!--SEP--><br></textarea>
					<script language="javascript" type="text/javascript">
						document.getElementById("lInfoViewItemContents").innerHTML = document.getElementById("contentsBuffer").value;
					</script>
				
			<!-- 외부 이미지 로딩 부분 -->
			<div id="preloadArea" class="gDisplayNone"></div>
			<script language="javascript" type="text/javascript">
				imageHook('lInfoViewItemContents');
			</script>

						<script type="text/javascript">
				itemContentsLinks	= document.getElementById('lInfoViewItemContents').getElementsByTagName('a');

				for(var i = 0; i < itemContentsLinks.length; i++)
				{
					linkTagBlockExp		= new RegExp('^http(s)?://domeggook\.com/');
					linkTagBlockExp2	= new RegExp('^(jpg|jpeg|png|gif)', 'gi');

					let hrefLength = itemContentsLinks[i].href.length;
					let lastIndex = itemContentsLinks[i].href.lastIndexOf('.');
					let hrefExt  = itemContentsLinks[i].href.substr(lastIndex+1, hrefLength).toLowerCase();
					
					if(!linkTagBlockExp.test(itemContentsLinks[i].href) && !linkTagBlockExp2.test(hrefExt))
					{
							itemContentsLinks[i].href	= 'javascript:void(0)';
							itemContentsLinks[i].target	= '_self';
					}
					
					
				}

				delete itemContentsLinks;
				delete linkTagBlockExp;
			</script>
			
			<!-- iFrame 체크 -->
			<script>
									permitDomain = new Array('ggook.com', 'domeggook.com', 'youtube.com', 'vimeo.com', 'player.vimeo.com');
					iframeUrlCheck('lInfoViewItemContents', permitDomain, true);
					delete permitDomain;
				
				setPropertyByTagName('lInfoViewItemContents', 'embed', 'wmode', 'transparent');
			</script>
		</div>
		

		<div id="lItemContentsMore">
			<a href="javascript:void(0)" id="lBtnItemContentsMore">
				<span id="lBtnItemContentsMoreText">상품상세 더보기</span>
				<img  id="lBtnItemContentsMoreIcon" src="https://cdn1.domeggook.com/image/mobile_v2/image/item/view/arrowDownGray.png" alt="" style=" width:24px; height:24px; margin-left:6px; vertical-align:middle;"/>
			</a>
		</div>

		<script type="text/javascript">
			// 상세정보 더보기 스크립트
			(function(){
				var CONTENTS_MAX_HEIGHT = 1200;

				var elContents = document.getElementById('lInfoViewItemContents');
				var elMoreWrap = document.getElementById('lItemContentsMore');
				var elMoreBtn = document.getElementById('lBtnItemContentsMore');
				var elMoreText = document.getElementById('lBtnItemContentsMoreText');
				var elMoreIcon = document.getElementById('lBtnItemContentsMoreIcon');

				var isExpanded = false;

				if(!elContents || !elMoreWrap || !elMoreBtn)
				{
					return;
				}

				function applyContentsState()
				{
					if(isExpanded)
					{
						elContents.style.overflow = '';
						elContents.style.maxHeight = '';
					}
					else
					{
						elContents.style.overflow = 'hidden';
						elContents.style.maxHeight = CONTENTS_MAX_HEIGHT + 'px';
					}
				}

				function checkItemContentsFold()
				{
					var needFold;

					// 높이 측정을 위해 잠깐 접힘 기준으로 계산
					elContents.style.overflow = 'hidden';
					elContents.style.maxHeight = CONTENTS_MAX_HEIGHT + 'px';

					needFold = elContents.scrollHeight > CONTENTS_MAX_HEIGHT;

					if(needFold)
					{
						elMoreWrap.style.display = 'block';
						applyContentsState();
						setButtonState();
					}
					else
					{
						elContents.style.overflow = '';
						elContents.style.maxHeight = '';
						elMoreWrap.style.display = 'none';
						isExpanded = false;
					}
				}


				function setButtonState()
				{
					if(isExpanded)
					{
						elMoreText.innerHTML = '상품상세 접기';

						// 접기 상태용 아이콘 회전
						if(elMoreIcon)
						{
							elMoreIcon.style.transform = 'rotate(180deg)';
						}
					}
					else
					{
						elMoreText.innerHTML = '상품상세 더보기';

						if(elMoreIcon)
						{
							elMoreIcon.style.transform = 'rotate(0deg)';
						}
					}
				}
				

				elMoreBtn.onclick = function()
				{
					if(isExpanded)
					{
						elContents.style.overflow = 'hidden';
						elContents.style.maxHeight = CONTENTS_MAX_HEIGHT + 'px';
						isExpanded = false;
						setButtonState();

						// 접을 때 버튼 위치가 화면에 남도록 보정
						$('html, body').stop(true).animate({
							scrollTop: $('#lItemContentsMore').offset().top - 120
						}, 0);
					}
					else
					{
						elContents.style.overflow = '';
						elContents.style.maxHeight = '';
						isExpanded = true;
						setButtonState();
					}

					// sticky tab 위치 재계산 필요시
					if(window.lItem && window.lItem.stickyTab && typeof window.lItem.stickyTab.setTabTop === 'function')
					{
						window.lItem.stickyTab.setTabTop('contents toggle');
					}

					return false;
				};


				// 최초 체크
				checkItemContentsFold();

				// 이미지 로드 후 다시 체크
				var imgs = elContents.getElementsByTagName('img');
				for(var i = 0; i < imgs.length; i++)
				{
					if(!imgs[i].complete)
					{
						imgs[i].onload = checkItemContentsFold;
						imgs[i].onerror = checkItemContentsFold;
					}
				}

				// 늦게 그려지는 컨텐츠 대응
				setTimeout(checkItemContentsFold, 300);
				setTimeout(checkItemContentsFold, 1000);
			})();
		</script>

					</div> 
	<script type="text/javascript">
	//  특정 scroll 시에만 ajax작동되도도록
		var ocrScrollDisFlag = false;
		var ocrWindowHeight = $(window).height();			// 화면 height 위치
		var ocrAiDivHeight = $('#ocrAiInfo').offset().top;  // div height 위치

		window.addEventListener('scroll', function() {
		// 스크롤 해서, 한번이라도 ajax불러왔다면

			if(ocrScrollDisFlag)
			{
				return false;
			}

			var ocrSCrollTop = $(window).scrollTop(); // scroll 위치

			// ocr 하단위치보다 현재 스크롤 위치가 더 크면
			if(ocrAiDivHeight < (ocrWindowHeight+ocrSCrollTop))
			{
				ocrScrollDisFlag = true;

				ocrAjax();
			}  
		});

		var lMdBannerSlider = new $JssorSlider$("mdBannerWrap",
		{
			$AutoPlay: false,
			$AutoPlayInterval: 4000,
			$PlayOrientation : 1,
			$DragOrientation: 1
		});

		lMdBannerSlider.$On($JssorSlider$.$EVT_SWIPE_END, function(position, virtualPosition){
			$('#lMainCenterTxtPagination b:first-child').text(parseInt(position + 1, 10));
		});

		$('#lMainCenterBtnPrev').bind('click', function(e){
				e.preventDefault();
				lMdBannerSlider.$Prev();
		});

		$('#lMainCenterBtnNext').bind('click', function(e){
				e.preventDefault();
				lMdBannerSlider.$Next();
		});



	</script><style type="text/css">
