			//관심상품의 일반회원 적용 제거
			var member_grade	= "";

			if(member_grade != 'n' && member_grade)
			{
				var addMyFavorItemBtn	= document.getElementById('lAddWishItemBtn');
				var addMyFavorItemImg	= document.getElementById('lAddWishItemImg');

				if(addMyFavorItemImg.src.indexOf('Off') > 0)
				{
					addMyFavorItemImg.src	= addMyFavorItemImg.src.replace('Off2', 'On2');
					addMyFavorItemBtn.style.color = '#EE6E4A';
				}
				else
				{
					addMyFavorItemImg.src	= addMyFavorItemImg.src.replace('On2', 'Off2');
					addMyFavorItemBtn.style.color = '#424242';
				}
			}

