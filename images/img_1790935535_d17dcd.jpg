<script type="text/javascript">
/*-----------------------------------------------------------------
	카테고리 BEST
-----------------------------------------------------------------*/
var catBestSlideShow	= function(no, _this)
{
	var getSlideUl	= document.getElementById('lCaBestListUl');
	var getSlideLis	= getSlideUl.getElementsByTagName('li');
	var getSlideCnt	= getSlideLis.length;

	var getSlideBtnUl	= document.getElementById('lCaBestSlideBtns');
	var getSlideBtnLis	= getSlideBtnUl.getElementsByTagName('li');
	var getSlideBtnCnt	= getSlideBtnLis.length;

	// 버튼선택 초기화
	for(var i=0; i<getSlideBtnCnt; i++)
	{
		getSlideBtnLis[i].setAttribute('class', '');
	}

	// 버튼 highlight
	_this.setAttribute('class', 'selected');

	// 상품목록의 none, block
	var startI	= (no - 1) * 0;	// 보여야할 목록의 첫번째 li
	var endI	= startI + -1;	// 보여야할 목록의 마지막 li

	for(var i=0; i<getSlideCnt; i++)
	{
		// 0~4, 5~9, 10~14
		if(i>=startI && i<=endI)
		{
			getSlideLis[i].setAttribute('class', 'dispBlock');
		}
		else
		{
			getSlideLis[i].setAttribute('class', 'dispNone');
		}
	}
}
</script>


