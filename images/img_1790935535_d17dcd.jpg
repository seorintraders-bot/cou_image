		#lPay .lInfoBody .lOptTotal .lAmtWrap .lCouponAmtUnit
		{
			color			: #D00;
		}
		#lGGOOKgross
		{
			width			:100%; 
			color			: #FFF;
			text-align		: center;
			font-family		: 'Malgun Gothic', '맑은 고딕', 'Apple SD Gothic Neo', 'Sans-serif';
			font-size		: 18px;
			font-style		: normal;
			font-weight		: 800;
			line-height		: 36px;
			background		: #18A0FB;
			height			: 36px;
			margin			: 10px 0 0 0;
		}
	</style>
	
	
	<div id="lPayBtnWrap">
		<table>
			<tbody>
				<tr>
										<td>
						<a id="lPayBtnCart" class="lPayBtn" href="#" onclick="onPayBtnClick('CART'); return false;">
							<button class="normal">장바구니</button>
						</a>
					</td>
					<td>
						<a id="lPayBtnBuy" class="lPayBtn" href="#" onclick="onPayBtnClick('ORDER'); return false;">
							<button class="buy">구매하기</button>
						</a>
					</td>
				</tr>
			</tbody>
		</table>
			</div>

	<!-- 장바구니 담기 토스트 메세지 -->
	<div id="lPayCartNotice">
		<div class="title">장바구니 담기</div>
		<div class="contents">
			장바구니에 상품을 담았습니다<br />
			바로 확인하겠습니까?
		</div>
		<div class="btn">
			<button class="cart">장바구니로</button>
			<button class="continue">계속 쇼핑</button>
		</div>
		<button class="close">닫기</button>
	</div>
	
	<!-- 사회공헌 활동 -->
	<div id="lPayDonate">
		<a href="https://gng.ggook.com/board/boardlist.php" target="_blank" title="사회공헌 활동">
			도매매 수입의 일부는 뜻깊은 사회공헌 활동에 쓰입니다
		</a>
	</div>


	<form method="GET" action="https://www.domeggook.com/main/myBuy/order/my_orderInfoForm.php" id="lPayFrmBuy">
		<input type="hidden" name="checkedItem" value="" />
		<input type="hidden" name="reqPresentInfo" value="" />
	</form>
	
	<script type="text/javascript">
		var lMode = 'ORDER';
		
		(function(){
			/*-----------------------------------------------------------------
			장바구니 담기 토스트 메세지
			-----------------------------------------------------------------*/
			$('#lPayCartNotice button.cart').bind('click', function(){
				$('#lPayCartNotice').hide();
				location.href = '/main/myBuy/order/my_orderCart.php';
			});
			
			$('#lPayCartNotice button.continue').bind('click', function(){
				$('#lPayCartNotice').hide();
			});
			
			$('#lPayCartNotice button.close').bind('click', function(){
				$('#lPayCartNotice').hide();
			});
		})();

		var _dialogDeliGlobal = $('#lDialogDeliGlobalAgreement');

		if(_dialogDeliGlobal.length)
		{
			var btn =
				'<button id="lBtnDeliGlobalAgree" class="pDialogBtn pDialogBtnHighlighted">동의</button>' +
				'<button class="pDialogBtn pDialogBtnClose">취소</button>';

			_dialogDeliGlobal.find('.pDialogFooter').html(btn);

			$('#lBtnDeliGlobalAgree').on('click', function(){
				_dialogDeliGlobal.hide();
				lAddCart(lMode);
			})
		}

		function onPayBtnClick(mode, side = '')
		{
			//  TT-4819 TT-4807 [도매매 사업자 유형 추가] 면세상품 거래 관련 팝업창 - 공급사 정보 확인
			var state = window.lItem.store.getState();			
			var market = state.market;
			var com_type = "1";
			var taxFlag = "N";
			var str = '';

			if(market == 'supply')
			{
				if(com_type == 3)
				{
					str = '공급사의 과세유형이 면세 입니다';
				}
				else if(com_type == 2 && taxFlag == 'N')
				{
					str = '공급사의 과세유형이 간이과세(세금계산서 발행불가) 입니다';
				}

				if(str)
				{
					if(!confirm(str + '\n구매를 진행하겠습니까?'))
					{
						return false;
					}
				}
			}
			// TT-4819 TT-4807 END

			if(_dialogDeliGlobal.length)
			{
				lMode = mode;
				_dialogDeliGlobal.show();
				return;
			}
			
			lAddCart(mode, side);
		}

		/*-----------------------------------------------------------------
		장바구니 추가
		-----------------------------------------------------------------*/
		function lAddCart(mode, side = '')
		{
			// 현재 선택한 탭의 market값 가져오기
			var state = window.lItem.store.getState();
			var market = state.market;
			var isMember = false;
			var memberGrade = '';
			var discountSetBasic = false; // 사업자전용할인 적용 여부
			var deliveryWho = 'P';
			var unitQty			= 5;
			var byUnitQty		= false;
			var cart 		= {"supply":""};
			var opt			= true; // 옵션 사용 여부
			var dw;
			var rt;
			var optController;	// 옵션사용 컨트롤러
			var running		= false;
			var param;
			var i, resultItem;

			var _gaOptData	= [];
			var _gaItem		= [];

			
			try
			{
				if(memberGrade !== 'c')
				{
					if(market === 'dome' && discountSetBasic || market === 'supply')
					{
						// 회원인 경우
						if(isMember)
						{
							// 사업자회원이 아니면 인증페이지로 이동
							throw ({
								msg: '사업자회원만 구매할 수 있습니다. 사업자 인증 안내페이지로 이동하겠습니까?',
								url: '/main/member/mem_formAuthCompany.php'
							});
						}
						// 비회원
						else
						{
							throw ({
								msg: '사업자회원만 구매할 수 있습니다. 로그인 화면으로 이동하겠습니까?',
								url: '/main/member/mem_formLogin.php?back=L3MvNjA1MTk1OTk%2Fbm89NjA1MTk1OTkmbWFya2V0PXN1cHBseQ%3D%3D'
							});
						}
					}
				}
			}
			catch(e)
			{
				if(confirm(e.msg))
				{
					location.href = e.url;
				}

				return false;
			}

			// 데이터 생성
			param = {
				format		: "json",
				mode		: "add",
				market		: market,
				no			: "60519599",
				sellerId	: "tjql12_growth",
				memo		: cart && cart[market] ? cart[market].memo : '',
				smp			: "",
				amt			: 0,
				qty			: 0,
				advcnt		: "",
				isCoupon 	: "0",
				// deliAmt		: 0, // deliAmt 파라미터를 사용하지 않음
			};
			
			// 옵션 데이터 생성
			if(opt)
			{
				// 상단 옵션 컨트롤러 가져오기
				optController = window.lItem.optController[market].pay;
				
				for(i = 0; i < optController.result.length; i++)
				{
					resultItem = optController.result[i];
					param['selectOpt[' + resultItem.code + ']'] = resultItem.qty;
					_gaOptData[resultItem.name] = resultItem.qty;
				}
			}
			else
			{
				_gaOptData['본품'] = param.qty;
			}
			
			// 총 수량 가져오기
			param.qty = window.lItem.baseAmtController.totalQty[market];

			// 배송비 - deliAmt 파라미터를 사용하지 않음
			// param.deliAmt = lCalcDeli(param.qty);

			// 총 금액(샘플단가 적용))
			if(opt)
			{
				// 샘플구매여부를 적용한 합계 금액 가져오기
				param.amt = optController.getTotalAmt(true);
			}
			// 옵션을 사용하지 않는 경우
			else
			{
				param.amt = window.lItem.baseAmtController.getTotalAmt(market);
			}

			// 유효성검사
			if(market === 'dome' && (param.qty < unitQty))
			{
				// 도매 구매인데 샘플구매가 불가능한 경우
				alert(number_format(unitQty) + '개 이상으로만 주문이 가능합니다');
				return false;
			}
			else if(market === 'dome' && byUnitQty && param.qty % unitQty && (param.qty >= unitQty))
			{
				// 도매 구매인데 배수로만 구매 가능이 설정된 경우
				alert('판매수량단위의 배수(' + number_format(unitQty) + '개)로만 주문이 가능합니다');
				return false;
			}

			// 유효성검사 - 옵션
			if(opt)
			{
				rt = optController.validateResult();
				
				if(!rt.isSuccess)
				{
					alert(rt.errMsg);
					return false;
				}
			}

			// 배송결제 방법
			if(deliveryWho === 'C')
			{
				param.dw = $('.lInfoBody[data-market=' + market + '] .lInfoDeliPayMethod .pSelectUI')[0].pSelectUI.selectedVal;
				
				if(!param.dw)
				{
					alert('배송결제 방법을 선택해주세요');
					return false;
				}
			}
			else
			{
				param.dw = deliveryWho;
			}
			//console.log('deliveryWho : ' + deliveryWho);
			//console.log('param.dw : ' + param.dw);
			if(market === 'dome')
			{
				if(param.qty < unitQty)
				{
					// 유효성검사 - 샘플구매를 사용하지 않는 경우
					alert(unitQty + '만 주문이 가능합니다');
					return false;
				}
				else if(param.qty > unitQty)
				{
					// 유효성검사 - 배수로만 주문가능으로 설정된 경우
					if(market === 'dome' && byUnitQty && param.qty % unitQty)
					{
						alert('판매수량단위(' + unitQty + '개)의 배수로만 주문이 가능합니다');
						return false;
					}
				}

				if(param.amt >= 1000000 && '' == '1')
				{
					if(confirm("100만원 이상 구매시 3% 할인 받으실 수 있습니다!\n할인 받으시겠습니까?"))
					{
						window.open('/main/popup/order/popup_promotion.php?no=60519599&market=dome&advcnt=evtPg','promotion_popup','width=800,height=740,top=30,left=30,scrollbars=yes,resizable=no');
						return false;
					}
				}
			}

			// 소비자정보 추가
			if(market === 'supply')
			{
				// 도매매 소비자정보를 입력하지 않았으면 입력창 띄우기
				if(!$('#lPayConsumer').is(':visible'))
				{
					$('#lPayConsumer').show();
					$('#lPayConsumer input[name=consumer_directOrder]').val(['GIFT', 'ORDER'].indexOf(mode) !== -1 ? '1': '0');
					return false;
				}
				// 소비자정보 입력시 데이터 추가
				else
				{
					param['cons[shop]']		= $('#lPayConsumer input[name=consumer_shop]').val();
					param['cons[name]']		= $('#lPayConsumer input[name=consumer_name]').val();
					param['cons[post]']		= $('#lPayConsumer input[name=consumer_zipcode]').val();
					param['cons[addr1]']	= $('#lPayConsumer input[name=consumer_address1]').val();
					param['cons[addr2]']	= $('#lPayConsumer input[name=consumer_address2]').val();
					param['cons[mobile1]']	= $('#lPayConsumer select[name=consumer_mobile1]').val();
					param['cons[mobile2]']	= $('#lPayConsumer input[name=consumer_mobile2]').val();
					param['cons[mobile3]']	= $('#lPayConsumer input[name=consumer_mobile3]').val();
					param['cons[phone1]']	= $('#lPayConsumer select[name=consumer_phone1]').val();
					param['cons[phone2]']	= $('#lPayConsumer input[name=consumer_phone2]').val();
					param['cons[phone3]']	= $('#lPayConsumer input[name=consumer_phone3]').val();
					param['cons[deliReq]']	= $('#lPayConsumer textarea[name=consumer_deliReq]').val();

					// 통관번호 정보
					
					param['consSetAddrBook'] = $('#lPayAddAddress').is(':checked')? '1': '0';
				}
			}

			// ga4 전송데이터
			var gaOptName = Object.keys(_gaOptData);
			for(var i = 0; i < gaOptName.length; i++)
			{
				_gaItem.push(
					{
						item_id: 60519599,
						item_name: '겨울 방한 기모 똑딱이 넥워머 LM-0542',
						item_brand: '라이크미그로스',
						item_variant: gaOptName[i],
						quantity: _gaOptData[gaOptName[i]]
					}
				);
			}
			 
			// Ajax 통신	
			if(!running)
			{			
				// Running Flag On
				running	= true;
				$('#lPayCartNotice').hide();

				$.ajax({
					type		: 'post',
					url			: '/main/myBuy/order/my_cartIng.php',
					data		: param,
					dataType	: 'json',
					success		: function(data){
						// Running Flag Off
						running = false;
 
						ttq.track('AddToCart', {
						contents: [
						{
							content_id: param.no, 			// 상품코드 *필수 - 동적구현
							content_type: 'product', 		// 상품종류 *필수 - product 또는 product_group으로 고정
							content_name: '겨울 방한 기모 똑딱이 넥워머 LM-0542', 			// 상품이름 *필수 - 동적구현
							quantity: param.qty, 			// 수량 *권장 - 동적구현
							price: param.amt, 	
						}],
						value: param.amt, //총 결제금액 *권장 - 동적구현
						currency: 'KRW', //통화 *권장 - 동적구현
						});

						// Alert
						if(data.res == 'success')
						{
							if(['GIFT', 'ORDER'].indexOf(mode) !== -1)
							{
								// <!--TT-4836 GA작업 바로구매 START -->
								dataLayer.push({
									  event: 'click_direct_order',
									  item_id: '60519599',
									  item_name: '겨울 방한 기모 똑딱이 넥워머 LM-0542',
									  item_brand: '라이크미그로스',
									  item_category: '',
									  item_category2: '',
									  item_category3: '',
									  item_category4: '',
									  item_category5: '',
									});
								// <!--TT-4836 GA작업 바로구매 END -->

								if(isMember)
								{
									$('#lPayFrmBuy input[name=checkedItem]').val(data.no);
									$('#lPayFrmBuy input[name=reqPresentInfo]').val(mode === 'GIFT' ? '1' : '');
									$('#lPayFrmBuy').submit();
								}
								else
								{
									location.href = '/main/member/mem_formLogin.php?back=L3MvNjA1MTk1OTk%2Fbm89NjA1MTk1OTkmbWFya2V0PXN1cHBseQ%3D%3D';
								}
							}
							else
							{
								// <!--TT-4836 GA작업 장바구니담기 START -->
								var ecom = {items: _gaItem};
								
								dataLayer.push({ ecommerce: null });
								dataLayer.push({
								  event: 'add_to_cart',
								  ecommerce: ecom
								});
								
								// <!--TT-4836 GA작업 장바구니담기 END -->

								// <!-- [FX-424] Danggeun Market Code -->
								window.karrotPixel.track('AddToCart');
								// <!-- End Danggeun Market Code -->

								// <!-- [FX-2054] 신규 픽셀 삽입 -->
								if(typeof fbq !== 'undefined')
								{
									fbq('track', 'AddToCart');
								}
								// <!-- [FX-2054] 신규 픽셀 삽입 -->



								$('#lPayConsumer').hide();
								$('#lPayCartNotice').show();
								
								if(side=='side')
								{
									console.log(window.innerHeight);
									$('#lPayCartNotice').css('top', (window.innerHeight/2+50));
									$('#lPayCartNotice').css('left', (window.innerWidth/2+100));
									$('#lPayCartNotice').css('position', 'fixed');
								}
								else
								{
									$('#lPayCartNotice').css('top', 'inherit');
									$('#lPayCartNotice').css('left', 'inherit');
									$('#lPayCartNotice').css('position', 'absolute');

								}
							}
						}
						else
						{
							alert(data.msg);
						}
					},
					error		: function(xhr, s, t){
						var errMsg = (['GIFT', 'ORDER'].indexOf(mode) !== -1 ? '구매' : '장바구니 담기') + '를 실패하였습니다. 다시 시도해주세요.';

						// Running Flag Off
						running = false;

						alert(errMsg);
					}
				});
			}

			return true;
		}
	</script>

	<!-- 상품 옵션 레이아웃 -->
	<script>
		
		/*-----------------------------------------------------------------
		전역 이벤트 등록
		-----------------------------------------------------------------*/
		window.lItem.store.subscribe('SET_MARKET', function(nextState, prevState){
		
			// 도매/배송대행 탭이 변경되면 엘리먼트 높이가 달라질 수 있으므로 콜백 실행
			lItemViewRedrawed('SET_MARKET');

			// 엘리먼트 클래스 변경
			$('#lPay')[0].className = nextState.market;
		})


		/*-----------------------------------------------------------------
		상품상세페이지 내에서 엘리먼트의 높이가 달라진 경우 실행할 콜백
		-----------------------------------------------------------------*/
		function lItemViewRedrawed(debug) {
			setTimeout(function(){
				window.lItem.stickyTab && window.lItem.stickyTab.setFixedPoint(debug);	// 고정되는 위치 재계산
				window.lItem.stickyTab && window.lItem.stickyTab.setTabTop(debug);		// 각 탭 위치 재계산
				window.lItem.stickyOpt && window.lItem.stickyOpt.setFixedPoint(debug);	// 고정되는 위치 재계산
			}, 0)
		}


		/*-----------------------------------------------------------------
		전체 합계 수량 및 금액 업데이트
		-----------------------------------------------------------------*/
		function lUpdateTotal(market, totalQty, totalAmt)
		{
			var elTotal;
			var couponAmtCalc = false;

			// 합계 수량 및 금액 변경
			elTotal = $('.lOptTotal[data-market=' + market + ']');
			elTotal.find('.lQty').text(number_format(totalQty));
			elTotal.find('.lAmt').text(number_format(totalAmt));

			if(couponAmtCalc)
			{
				var maxDiscountAmt = 0 > 0 ? 0 : 0;
				var discountAmt = 0 > 0 ? Math.floor(0 * 0.01 * totalAmt) : 0;
				var couponAmt = totalAmt - (maxDiscountAmt ? Math.min(discountAmt, maxDiscountAmt) : discountAmt);

				elTotal.find('.lCouponAmt').text(number_format(couponAmt));
				
				$('.lAmt').addClass('lCancelAmt');
				$('.lCouponBadge').show();
				$('.lCouponAmt').show();
				$('.lCouponAmtUnit').show();
			}
			else
			{
				$('.lAmt').removeClass('lCancelAmt');
				$('.lCouponBadge').hide();
				$('.lCouponAmt').hide();
				$('.lCouponAmtUnit').hide();
			}


			// 0원인 경우 합계 엘리먼트 숨기기
			totalAmt ? elTotal.removeClass('lHidden') : elTotal.addClass('lHidden');
		}

		
		
			
		/*-----------------------------------------------------------------
		상품 수량 선택 Controller
		-----------------------------------------------------------------*/
					// 상품 주문옵션을 사용하는 경우
			window.lItem.optController = {};
				</script>

</div>


<script>

	// 주소지 정보 설정
	var consumerShop = '';
	var consumerAddrBook = {};
	var isConsumerAddrBookLoaded = false;

	// 주소록 정보 최초 1회 로딩
	function getConsumerAddrBook()
	{
		$.ajax({
			type 		: 'POST',
			url			: '/main/item/itemAddrBook.php',
			dataType	: 'json',
			success		: function(data){
				if(data.res == 'success')
				{
					consumerAddrBook = data.result;
						
					// 최근 소비자정보(수령인명)가 있으면 라디오 버튼 노출
					if(consumerAddrBook.recent && $.trim(consumerAddrBook.recent.name || '') != '')
					{
						$('#lPayAddrOpt .lRecentAddrOpt').show();
					}
					else
					{
						$('#lPayAddrOpt .lRecentAddrOpt').hide();
					}
				}
				else
				{
					consumerAddrBook = {};
					$('#lPayAddrOpt .lRecentAddrOpt').hide();
				}
			},
			error		: function(){
				consumerAddrBook = {};
				$('#lPayAddrOpt .lRecentAddrOpt').hide();
			},
			complete	: function(){
				isConsumerAddrBookLoaded = true;
			}
		});
	}

	// 주소록 로딩 완료 여부 확인
	function checkConsumerAddrBookLoaded()
	{
		if(!isConsumerAddrBookLoaded)
		{
			alert('주소록 정보를 불러오는 중입니다. 잠시 후 다시 선택해주세요.');
			return false;
		}

		return true;
	}

	// 주소 데이터가 없거나 아직 로딩 전이면 직접작성으로 되돌림
	function setConsumerAddrOptWrite()
	{
		$('#lPayAddrOpt input.write').click();
	}

	// 주소 데이터 적용
	function setConsumerAddrBook(type, emptyMsg)
	{
		if(!checkConsumerAddrBookLoaded())
		{
			setConsumerAddrOptWrite();
			return;
		}

		if(consumerAddrBook[type])
		{
			addressBookSet(consumerAddrBook[type]);
		}
		else
		{
			alert(emptyMsg);
			setConsumerAddrOptWrite();
		}
	}

	// 최근 입력한 상호
	function setConsumerShop(act)
	{
		var object = $('#lPayConsumer input[name=consumer_shop]');

		if($('#lConsumerShop').is(':checked') == true)
		{
			if(!checkConsumerAddrBookLoaded())
			{
				$('#lConsumerShop').prop('checked', false);
				return;
			}

			if(consumerAddrBook.consumerShopRecent)
			{
				object.val(consumerAddrBook.consumerShopRecent);
			}
			else
			{
				alert('최근 입력한 상호가 없습니다.');
				$('#lConsumerShop').prop('checked', false);
			}
		}
		else
		{
			object.val(consumerShop);
		}
	}

</script>

	<!-- 배송대행 - 소비자 배송정보 입력 레이아웃 -->
	<div id="lPayConsumer">
		<form class="frm" name="consumer">
			<h3>소비자 배송정보 입력</h3>
			<div class="desc">배송대행 상품을 수령할 실제 소비자 정보를 우선 입력해주세요</div>
			<input type="hidden" name="consumer_directOrder" value="0" />
			<table>
				<tr>
					<th valign="top">쇼핑몰(상호)</th>
					<td>
						<input type="text" name="consumer_shop" value="" style="width:320px; text-indent:8px;" />
						&nbsp;<input id="lConsumerShop" type="checkbox" value="" onclick="setConsumerShop(this);" />&nbsp;최근 입력한 상호
					</td>
				</tr>
				<tr>
					<th valign="top">배송지선택</th>
					<td id="lPayAddrOpt">
						<label><input type="radio" name="consumer_addropt" class="basis" />기본배송지</label>
						<label><input type="radio" name="consumer_addropt" class="member" />회원정보와 동일</label>
						<label class="lRecentAddrOpt"><input type="radio" name="consumer_addropt" class="recent" />최근 소비자정보</label>
						<label><input type="radio" name="consumer_addropt" class="addrbook" />주소록에서 선택</label>
						<label><input type="radio" name="consumer_addropt" class="write" checked/>직접작성</label>
					</td>
				</tr>
				<tr>
					<th valign="top">소비자명</th>
					<td>
						<input type="text" name="consumer_name" value="" class="lenfull" />
					</td>
				</tr>
				<tr>
					<th valign="top">수령지주소</th>
					<td>
						<input type="text" name="consumer_zipcode" value="" maxlength="7" class="lenpost" readonly="readonly" />
						<input type="button" value="우편번호검색" class="inputBtn" id="lPayFindPost" />
						<span id="lPayAddrCheck">
							<input type="checkbox" id="lPayWritableAddress" />주소직접입력
							<input type="checkbox" id="lPayAddAddress" />주소록에 추가
						</span>
						<br />
						<input type="text" name="consumer_address1" value="" class="lenfull" readonly="readonly" /><br />
						<input type="text" name="consumer_address2" value="" class="lenfull" />
					</td>
				</tr>
				<tr>
					<th valign="top">휴대전화</th>
					<td>
						<select name="consumer_mobile1" class="lenshort">					
							<option value="010">010</option><option value="011">011</option><option value="016">016</option><option value="017">017</option><option value="018">018</option><option value="019">019</option><option value="050">050</option><option value="0502">0502</option><option value="0503">0503</option><option value="0504">0504</option><option value="0505">0505</option><option value="0506">0506</option><option value="0507">0507</option><option value="0508">0508</option><option value="0707">0707</option>						</select> -
						<input type="text" name="consumer_mobile2" value="" maxlength="4" class="lenshort" /> -
						<input type="text" name="consumer_mobile3" value="" maxlength="4" class="lenshort" />
					</td>
				</tr>
				<tr>
					<th valign="top">전화번호</th>
					<td>
						<select name="consumer_phone1"class="lenshort">			
							<option value="02">02</option><option value="010">010</option><option value="011">011</option><option value="016">016</option><option value="017">017</option><option value="018">018</option><option value="019">019</option><option value="031">031</option><option value="032">032</option><option value="033">033</option><option value="041">041</option><option value="042">042</option><option value="043">043</option><option value="044">044</option><option value="050">050</option><option value="050">050</option><option value="051">051</option><option value="052">052</option><option value="053">053</option><option value="054">054</option><option value="055">055</option><option value="061">061</option><option value="062">062</option><option value="063">063</option><option value="064">064</option><option value="070">070</option><option value="080">080</option><option value="0130">0130</option><option value="0303">0303</option><option value="0502">0502</option><option value="0503">0503</option><option value="0504">0504</option><option value="0505">0505</option><option value="0506">0506</option><option value="0507">0507</option><option value="0508">0508</option><option value="0707">0707</option>						</select> -
						<input type="text" name="consumer_phone2" value="" maxlength="4" class="lenshort" /> -
						<input type="text" name="consumer_phone3" value="" maxlength="4" class="lenshort" />
					</td>
				</tr>
				<tr>
					<th valign="top">배송요청사항</th>
					<td>
						<textarea name="consumer_deliReq" class="lenfull"></textarea>
					</td>
				</tr>
							</table>

			<button class="submit">저장</button>
			<button class="close">닫기</button>
		</form>
		
		<!--우편번호검색 카카오 주소 api 추가-->
		<script type="text/javascript" src="/main/common/jscript/js_daumPostCode.js"></script>
		<script type="text/javascript">
			function addressBookSet(dat)
			{
				$('#lPayConsumer input[name=consumer_name]').val(dat.name);
				$('#lPayConsumer input[name=consumer_zipcode]').val(dat.post? dat.post: dat.zip);
				$('#lPayConsumer input[name=consumer_address1]').val(dat.addr1);
				$('#lPayConsumer input[name=consumer_address2]').val(dat.addr2);

				if(dat.mobile[0])
				{
					$('#lPayConsumer select[name=consumer_mobile1]').val(dat.mobile[0]);

					$('#lPayConsumer input[name=consumer_mobile2]').val(dat.mobile[1]);
					$('#lPayConsumer input[name=consumer_mobile3]').val(dat.mobile[2]);
				}

				if(dat.phone[0])
				{
					$('#lPayConsumer select[name=consumer_phone1]').val(dat.phone[0]);

					$('#lPayConsumer input[name=consumer_phone2]').val(dat.phone[1]);
					$('#lPayConsumer input[name=consumer_phone3]').val(dat.phone[2]);
				}

				if(dat.buyer)
				{	
					$('#lPayConsumer input[name=consumer_shop]').val(dat.buyer);
					consumerShop	= dat.buyer;
				}

				$('#lPayConsumer textarea[name=consumer_deliReq]').val(dat.deliReq);
				
				if(dat.ccnoType)
				{	
					$('#lPayConsumer input:radio[name=consumer_ccnoType][value=' + dat.ccnoType + ']').prop('checked', true);
					$('#lPayConsumer input[name=consumer_ccno]').val(dat.ccno);
				}

			}

			

			(function($) {
				
				// 주소록 정보
				//var addr = {};


				// 페이지 로드 시 주소록 정보 1회 호출
				getConsumerAddrBook();
				
				// empty message
				var consumerAddrBookOpt = {
					basis	: '기본 배송지가 없습니다.',
					member	: '회원정보가 없습니다.',
					recent	: '최근 소비자 정보가 없습니다.'
				};

				// 수령지주소 각 라디오버튼 동작 bind 
				$.each(consumerAddrBookOpt, function(type, emptyMsg){

					$('#lPayAddrOpt input.' + type).bind('click', function(e){
						setConsumerAddrBook(type, emptyMsg);
					});
				});

				// 직접입력 
				$('#lPayAddrOpt input.write').bind('click', function(e){
					addressBookSet({name:'', zip:'', addr1:'', addr2:'', mobile: {0:'010', 1:'', 2:''}, phone: {0:'02', 1:'', 2:''}, ccnoType: 'ind', ccno:''});
				});

				// 통관번호
				$('input:radio[name="consumer_ccnoType"]').bind("click", function(){

					// 선택된 항목에 따라 
					if($('input:radio[name="consumer_ccnoType"]:checked').val() == "ind")
					{
						$("#ccnoIndDesc").show();
						$("#ccnoComDesc").hide();
					}
					else
					{
						$("#ccnoComDesc").show();
						$("#ccnoIndDesc").hide();
					}
				});


				// 주소록 팝업
				$('#lPayAddrOpt input.addrbook').bind('click', function(e){
					var wid	= 500;
					var hei	= 400;
					var lis	= screen.width / 2 - wid / 2;
					var tis	= screen.height / 2 - hei /2 ;

					window.open('/main/myBuy/order/my_orderAddressBook.php?mode=supply', 'ngm_addressBook', 'width=' + wid + ', height=' + hei + ', scrollbars=yes, left=' + lis + ', top=' + tis);
				});

				// 우편번호 검색
				$('#lPayFindPost').bind('click', function(e){
					e.preventDefault();
					daumPostCode('consumer', 'consumer');
				});

				// 주소지 직접 입력
				$('#lPayWritableAddress').bind('click', function(e){
					if($(this).is(':checked'))
					{
						$('#lPayConsumer input[name=consumer_zipcode]').removeAttr('readonly');
						$('#lPayConsumer input[name=consumer_address1]').removeAttr('readonly');
					}
					else
					{
						$('#lPayConsumer input[name=consumer_zipcode]').attr('readonly', 'readonly');
						$('#lPayConsumer input[name=consumer_address1]').attr('readonly', 'readonly');
					}
				});

				// 소비자정보 역슬래시 및 원화표시 입력 불가			
				$('#lPayConsumer').on('keydown input', 'input, textarea', function (e) {
					if (e.type === 'keydown' && e.key === '\\') e.preventDefault();
					if (e.type === 'input') this.value = this.value.replace(/[\u20A9\uFFE6\u005C\uFF3C]/g, '');
				});

				// 저장
				$('#lPayConsumer button.submit').bind('click', function(e){
					e.preventDefault();

					try
					{
						if(!$('#lPayConsumer input[name=consumer_shop]').val().length)
						{
							$('#lPayConsumer input[name=consumer_shop]').focus();
							throw('쇼핑몰(상호)를 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_name]').val().length)
						{
							$('#lPayConsumer input[name=consumer_name]').focus();
							throw('소비자명을 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_zipcode]').val().length)
						{
							$('#lPayConsumer input[name=consumer_zipcode]').focus();
							throw('수령지주소를 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_address1]').val().length)
						{
							$('#lPayConsumer input[name=consumer_address1]').focus();
							throw('수령지주소를 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_address2]').val().length)
						{
							$('#lPayConsumer input[name=consumer_address2]').focus();
							throw('수령지주소를 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_mobile2]').val().length)
						{
							$('#lPayConsumer input[name=consumer_mobile2]').focus();
							throw('휴대전화를 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_mobile3]').val().length)
						{
							$('#lPayConsumer input[name=consumer_mobile3]').focus();
							throw('휴대전화를 입력해주세요');
						}

						if(!$('#lPayConsumer input[name=consumer_phone2]').val().length && $('#lPayConsumer input[name=consumer_phone3]').val().length)
						{
							$('#lPayConsumer input[name=consumer_phone2]').focus();
							throw('전화번호를 정확히 입력해주세요');
						}

						if($('#lPayConsumer input[name=consumer_phone2]').val().length && !$('#lPayConsumer input[name=consumer_phone3]').val().length)
						{
							$('#lPayConsumer input[name=consumer_phone3]').focus();
							throw('전화번호를 정확히 입력해주세요');
						}

											}
					catch(e)
					{
						alert(e);
						return false;
					}

					lAddCart($('#lPayConsumer input[name=consumer_directOrder]').val() === '1' ? 'ORDER' : '');
				})

				// 닫기
				$('#lPayConsumer button.close').bind('click', function(e){
					e.preventDefault();
					$('#lPayConsumer').hide();
				})

			})(jQuery);
		</script>
	</div>	

<script>
var detailContents = "true";
var itemStatus	   = "진행중";
//console.log(itemStatus);
if(detailContents == 'false')
{
	$("#lPayInfoBody").empty();
	$("#lPayBtnWrap").empty();
	$("#lPayBtnWrap").css('width', '100%');
	$("#lPayBtnWrap").append($('<div style="height:54px; color:#FF0000; font-size:24px; line-height:52px; text-align:center; border:1px solid #FF0000; margin-top:20px; margin-bottom:5px;">현재 품절로 인해 한시적으로 판매가 중단되었습니다</div>'));
}

if(itemStatus == '기간종료')
{
	$("#lPayInfoBody").empty();
	$("#lPayBtnWrap").empty();
	$("#lPayBtnWrap").css('width', '100%');
	$("#lPayBtnWrap").append($('<div style="height: 54px;color: #FFF;font-size: 24px;line-height: 52px;font-weight: bold;background: #ccc;text-align: center;margin-top: 20px;margin-bottom: 5px;">판매기간이 종료된 상품입니다</div>'));
}

if(itemStatus == '판매종료')
{
	$("#lPayInfoBody").empty();
	$("#lPayBtnWrap").empty();
	$("#lPayBtnWrap").css('width', '100%');
	$("#lPayBtnWrap").append($('<div style="height: 54px;color: #FFF;font-size: 24px;line-height: 52px;font-weight: bold;background: #ccc;text-align: center;margin-top: 20px;margin-bottom: 5px;">재고가 없는 상품입니다</div>'));
}
if(itemStatus == '최소재고부족')
{
	$("#lPayInfoBody").empty();
	$("#lPayBtnWrap").empty();
	$("#lPayBtnWrap").css('width', '100%');
	$("#lPayBtnWrap").append($('<div style="height: 54px;color: #FFF;font-size: 24px;line-height: 52px;font-weight: bold;background: #ccc;text-align: center;margin-top: 20px;margin-bottom: 5px;">재고가 없는 상품입니다</div>'));
}

var bUseNegoPayBtn = "";
if(bUseNegoPayBtn == 'false')
{
	$("#lOptBtnNego").hide();
}
</script>

<script>
window.onload = function() {
	const params = new URLSearchParams(window.location.search);
	
	if (params.get("cart") === "edit" && 'supply' == 'supply')
	{
		const cartBtn = document.getElementById("lPayBtnCart");
        
		if (cartBtn) {
          cartBtn.click(); // 버튼 클릭 실행
        }
	}
}
</script><div style="clear:both"></div></div><div style="padding:15px 0;"></div><!-- 공급사의 인기상품 -->
<div id="lSeller">
	<style>
		#lSeller
		{
			position		: relative;
			margin			: 30px 0px 0px 0;
			width			: 100%;
			border-top		: 2px solid #1B1B1B;
		}
		#lSeller #lSellerPop
		{
			position		: relative;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader
		{
			position		: relative;
			margin			: 0;
			padding			: 20px 10px 10px 20px; 
			height			: 50px;
			width			: 938px;
			box-sizing		: border-box;
			letter-spacing	: -1px;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader .lShown
		{
			display			: block;
		}
		/* 공급사 인기상품 / 묶음배송 가능상품 탭 버튼 */
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnTabTitle
		{
			font-size		: 20px;
			font-weight		: bold;
			letter-spacing	: -1px;
			color			: #CECECE;
			margin-left		: 20px;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnTabTitle.lBtnFirst
		{
			margin-left		: 0;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnTabTitle:hover
		{
			text-decoration	: underline;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnTabTitle.lSelected
		{
			color			: #1B1B1B;
		}
		/* 공급사 인기상품 / 묶음배송 가능상품 더보기 버튼 */
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnMore
		{
			display			: none;
			position		: absolute;
			top				: 20px;
			right			: 0px;
			border			: 1px solid #DDD;
			text-decoration	: none;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnMore.lShown
		{
			display			: block;
		}
		#lSeller #lSellerPop > #lSellerItemListHeader .lBtnMore button
		{
			height			: 24px;
			width			: 76px;
			font-size		: 14px;
			text-align		: center;
		}
		#lSellerPopItemListWrap
		{
			display			: inline-block;
			position		: relative;
			width			: 938px;
			height			: 240px;
		}
		#lSellerPopItemListWrap #lSellerPopItemListTab
		{
			position		: absolute;
			top				: -20px;
			right			: 0;

		}
		#lSellerPopItemListWrap #lSellerPopItemListTab .lBtn
		{
			padding			: 0 12px;
			color			: #828282;
		}
		#lSellerPopItemListWrap #lSellerPopItemListTab .lBtn.lSelected
		{
			font-weight		: bold;
			color			: #343434;
		}

		/* 인기상품 목록 */
		#lSeller .lSellerItemList
		{
			display	 		: none;
			overflow		: hidden;
			float			: left;
			margin			: 0;
			padding			: 20px 0px 20px 20px;
			box-sizing		: border-box;
		}
		#lSeller .lSellerItemList.lShown
		{
			display			: block;
		}
		#lSeller .lSellerItemList li
		{
			float			: left;
			margin-left		: 30px;
			width			: 128px;
			height			: 200px;
		}
		#lSeller .lSellerItemList li:first-child
		{
			margin-left		: 0;
		}
		#lSeller .lSellerItemList li a
		{
			display		 	: block;
			color			: #1B1B1B;
			font-size		: 11px;
			font-weight		: normal;
			text-decoration	: none;
			letter-spacing	: -1px;
