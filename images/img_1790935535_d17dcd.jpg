		</div>
				<div class="lInfoViewNoticeWrap">
			<table class="lInfoViewNoticeTbl">
				<tbody>
				<tr>
					<td>
						<div class="lInfoViewNoticeTitle">
							<img src="https://cdn1.domeggook.com/image/item/view/ico_notice.png" border="0" alt="공급사 공지사항" title="공급사 공지사항"/>공급사 공지사항
						</div>
					</td>
				</tr>
				<tr>
					<td class="lInfoViewNoticeTd">
							<div id="sellerNoticeT"><div style="text-align: center;"><img src="https://gi.esmplus.com/hheimish2/%EB%8F%84%EB%A7%A4%EA%BE%B9%EC%95%88%EB%82%B4%EC%84%9C.jpg" style="font-size: 9pt;"></div></div>

							<script type="text/javascript">

								/*-------------------------------
								gift.domeggook.com 대응(TT-3887)
								--------------------------------*/
								var sellerNoticeHref = $("#sellerNoticeT a").attr("href");

								$(document).ready(function(){
									if('tjql12_growth' == 'storelink1220'
									&& sellerNoticeHref == 'http://gift.domeggook.com')
									{
										sellerNoticeHref += "/?no=60519599";
										$("#sellerNoticeT a").attr("href", sellerNoticeHref);
									}
								});
								// (TT-3887 끝)

								itemContentsLinks	= document.getElementById('sellerNoticeT').getElementsByTagName('a');
								linkTagBlockExp		= new RegExp('(^http(s)?://domeggook.com/)|(^http(s)?://domemedb.domeggook.com/)');

								
								for(var i = 0; i < itemContentsLinks.length; i++)
								{

									if(!linkTagBlockExp.test(itemContentsLinks[i].href))
									{
										itemContentsLinks[i].href	= 'javascript:void(0)';
									}
								}

								delete itemContentsLinks;
								delete linkTagBlockExp;

								permitDomain = new Array('ggook.com', 'domeggook.com', 'youtube.com', 'vimeo.com', 'player.vimeo.com');
								iframeUrlCheck('sellerNoticeT', permitDomain, true);
								setPropertyByTagName('sellerNoticeT', 'embed', 'wmode', 'transparent');
								delete permitDomain;

								// Image Resize
								(function(){
									$('#sellerNoticeT img').each(function(){
										var w = parseInt($(this).width(), 10);

										if(w > 930)
										{
											$(this).width(930);
										}
									});
								})();
							</script>
					</td>
				</tr>
				</tbody>
			</table>
		</div>

				<!-- 상품정보 -->
		<div id="lInfoViewItemInfoWrap">

			<div class="lTblTitle">상품정보</div>

			<div class="lTblWrap">
				<div class="lTblRow">
					<div class="lTbl lTblHalf">
						<label class="lTblCell lTblCellLabel">원산지</label>
