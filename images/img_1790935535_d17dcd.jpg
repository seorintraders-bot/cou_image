	<script type="text/javascript">
		// ajax data setting
		var market = 'supply';
		var no = '60519599';
		var dataArr = [];
		var pattern = /^[0-9]+$/;

		var scrollFlag = false;

		// scroll 한번실행시만 실행되는 함수
	  	window.addEventListener('scroll', function() {
				dataArr.push('market='+market);
				dataArr.push('no='+no);

				// validate
				try
				{
					if(scrollFlag)
					{
						return false;
					}

					if(!(market == 'dome' || market == 'supply'))
					{
						throw('입력값이 잘못되었습니다1.');
					}

					if(pattern.test(no) === false)
					{
						throw('상품번호가 잘못되었습니다.');
					}
				}
				catch(e)
				{
					alert(e);
					return false;
				}

				scrollFlag = true;
				
				$.ajax({
					url: "/main/item/itemView/sellerPopularListAjax2.php",
					type: "GET",
					data: dataArr.join('&'),
					dataType: "json",
					success: function(content) 
					{					

						if(content.res == 'true')
						{
							var itmeObj = content.data.itemListPopAndCate.item;
							var packObj = content.data.itemListPack.item;

							/* 인기상 품 또는 카테고리 */
							// 1) header : 
							if(content.data.itemListPopAndCate.title == '')
							{
								return false;
							}

							$('#lTabMenu1 button:first').append(content.data.itemListPopAndCate.title);
							$('#lTabMenu1 a').prop('href', content.data.itemListPopAndCate.refUrl);

							// 2) wrap 그리기 (카테고리100, 인기상품 둘다 없는건데 이런경우 있는지 확인)
							// 무조건있다는 전제하에 코딩한거라, 없는경우도 있으면 묶음배송도 안그려짐
							if(itmeObj == '')
							{
								return false;
							}
						
							const keys1 = Object.keys(itmeObj); 
							var wrapHtml1 = '<ul data-key="pop" class="lSellerItemList lShown" data-market="'+ market +'">';
								
							for (var i = 0; i < keys1.length; i++) {
								wrapHtml1 += '<li>'+
									'<a href="/'+itmeObj[i].no+'?market='+market+'&from='+content.data.itemListPopAndCate.refUrl+'" target="_blank">'+
										'<img src="'+itmeObj[i].img+'" width="120" height="120" title="'+itmeObj[i].title+'" />'+
										'<div class="lItemTitle">'+itmeObj[i].title+'</div>'+
										'<div class="lItemAmt">'+itmeObj[i].amt+'<span class="lItemAmtUnit">원</span></div>'+
									'</a>'+
								'</li>';
							}
							wrapHtml1 += '</ul>';
							$('#lSellerPopItemListWrap').html(wrapHtml1);
							
							/* 묶음배송 */
							if(packObj == '')
							{
								// 1) header 삭제
								$('#lTabMenu2').remove();
							}
							else
							{
								// 1) header 
								$('#lTabMenu2 button:first').append('묶음배송 가능상품');
								$('#lTabMenu2 a').prop('href', content.data.itemListPack.refUrl);		

								// 2) wrap 그리기
								const keys2 = Object.keys(packObj); 
								var wrapHtml2 = '<ul data-key="pack" class="lSellerItemList" data-market="'+market+'">';
								
								for (var j = 0; j < keys2.length; j++)
								{
								wrapHtml2+=	'<li>' +
											'<a href="/'+packObj[j].no+'?market='+market+'&from=sellerPackDeli" target="_blank">'+
												'<img src="'+packObj[j].img+'" width="120" height="120" title="'+packObj[j].title+'" />'+
												'<div class="lItemTitle">'+packObj[j].title+'</div>'+
												'<div class="lItemAmt">'+packObj[j].amt+'<span class="lItemAmtUnit">원</span></div>'
											'</a>'+
										'</li>';
								}
								wrapHtml2 += '</ul>';
								$('#lSellerPopItemListWrap').append(wrapHtml2);
							}
						}
						else
						{
							alert('공급사정보를 가져오지 못했습니다. ' + res.msg);
						}
							
					}
				});
		});


		$(function(){
		
			$('#lSellerItemListHeader').on('click', '.lBtnTabTitle', function(){
				var btn = $(this)
				var key = btn.attr('data-key')

				// 탭 제목 상태 변경
				$('#lSellerItemListHeader .lBtnTabTitle').removeClass('lSelected')
				btn.addClass('lSelected')

				// 더보기 버튼 변경
				$('#lSellerItemListHeader .lBtnMore').removeClass('lShown')
					.filter('[data-key=' + key + ']').addClass('lShown')

				// 탭 내용 상태 변경
				$('.lSellerItemList').removeClass('lShown')
					.filter('[data-key=' + key + ']').addClass('lShown')
			})

			// 공급사정보 - 자세히보기 버튼
			var _elBtn = $('#lBtnShowSellerInfoDetail');

			_elBtn.on('click', function(e){
				e.preventDefault();
				$('#lSellerPopInfoDetail').appendTo('#lSeller').addClass('lShown')
			})

							/*-----------------------------------------------------------------
				관심공급사 버튼
				-----------------------------------------------------------------*/
				$('#lBtnAddWishMember').on('click', function(e){
					
					e.preventDefault();
					
					if(confirm('관심공급사 기능을 사용하려면 로그인을 해야합니다\n로그인페이지로 이동하시겠습니까?'))
					{
						location.href = '/main/member/mem_formLogin.php?back=L3MvNjA1MTk1OTk%2Fbm89NjA1MTk1OTkmbWFya2V0PXN1cHBseQ%3D%3D';
					}

					return false;
				})
					});
	</script>

</div>
