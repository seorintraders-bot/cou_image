<!-- Swiper -->
<div id="categorySwiperZone">
	<div id="myPageSwiperCategory" class="swiper myPageSwiper">
	  <div id="recommCategoryWrap" class="swiper-wrapper"></div>
	</div>
</div>

<script type="text/javascript">
    var categoryTargetId = "01_22";
    var categorySkip = "0";
    var categoryPageLimit = "50";
    var categorySolutionType = "categoryItem";
    var categorySwiperTitle = "<font style=\"color:#329946;\">꾹AI:추천</font> 지금 이 카테고리에서 주목할 상품";
    var categoryScrollDisFlag = ""; // 스크롤 이벤트 무시 bool
    var categoryScrollFlagAitemsBottom = false; // 위 플래그가 false일때 유효, 스크롤 유무 flag
	var categoryMarket = "supply";
	var categoryItemNo = "60519599";
    
	
    function execAjaxCategory()
    {
        $.ajax({
            url: "/main/item/itemView/aitemsOrderRecommAjax.php",
            type: "GET",
            data: "targetId="+categoryTargetId+"&skip="+categorySkip+"&pageLimit="+categoryPageLimit+"&type="+categorySolutionType+"&market="+categoryMarket,
            dataType: "json"
        })
        .done(function(content)
        {
            let listHtml = '';
            if(content.res == true)
            {
				let datalist = [];

                for(idx in content.data)
				{
					// 상세에 있는 상품번호와 추천결과가 같으면 skip
					if(categoryItemNo == content.data[idx].no) 
					{
						continue; // 상세 상품이면 제외
					}

					datalist.push(content.data[idx]);
				}

				// 5배수 최대값 설정
				let useCount = Math.floor(datalist.length / 5) * 5;

				if(useCount == 0)
				{
					return;
				}
							
				// 필요한 만큼만 slice
				datalist = datalist.slice(0, useCount);
				
                let preHtml = '<div class="categoryRecommTitle">'+categorySwiperTitle+'</b></div>'
                                +'<div class="category-swiper-pagination"></div>'
                                + '<div class="swiper-button-next category-next"></div>'
                                + '<div class="swiper-button-prev category-prev"></div>';
                $('#categorySwiperZone').show();
                $('#categorySwiperZone').prepend(preHtml);

				
				datalist.forEach(function(row) {
				
					// list html 붙이기
					listHtml+= '<div class="swiper-slide">'+
									'<a href="'+row.refUrl+'" target="_blank">'+
										'<div><img src="'+row.img+ '"/></div>' +
										'<div class="lItemTitle">'+row.title+'</div>' +
										'<div class="lItemAmt">'+row.amt+'<span class="lItemAmtUnit">원</span></div>'+
									'</a>'+
							'</div>';
				});

                $("#recommCategoryWrap").append(listHtml);
                
				// swiper js css 없는 경우 삽입
				if (typeof Swiper === 'undefined') {
					var script = document.createElement('script');
					script.src = '/sc/common/module/swiper/swiper-bundle-v8.min.js';
					script.type = 'text/javascript';
					script.onload = function() {
						var swiper = new Swiper("#myPageSwiperCategory", {
							slidesPerView: 5,
							spaceBetween: 25,
							slidesPerGroup: 5,
							pagination: {
								el: ".category-swiper-pagination",
								type: "fraction",
							},
							loopFillGroupWithBlank: true,
							loop: true,
							navigation: {
								nextEl: ".category-next",
								prevEl: ".category-prev",
							},
						});
					};
					document.getElementsByTagName('head')[0].appendChild(script);

					var link = document.createElement('link');
					link.href = '/sc/common/module/swiper/swiper-bundle-v8.min.css';
					link.rel = 'stylesheet';
					document.getElementsByTagName('head')[0].appendChild(link);
				}
				else
				{
					var swiper = new Swiper("#myPageSwiperCategory", {
						slidesPerView: 5,
						spaceBetween: 25,
						slidesPerGroup: 5,
						pagination: {
							el: ".category-swiper-pagination",
							type: "fraction",
						},
						loopFillGroupWithBlank: true,
						loop: true,
						navigation: {
							nextEl: ".category-next",
							prevEl: ".category-prev",
						},
					});
				}
            }
            else
            {
                $('#categorySwiperZone').hide();
            }
        })
        .fail(function(){
            $('#categorySwiperZone').hide();
        });
    }

    
    // 상세페이지시 스크롤 이벤트에 따라 ajx호출
    if(!categoryScrollDisFlag)
    {
        var categorySwiperZonePlace =  $('#categorySwiperZone').offset().top; // 하단 swiper 위치
        var categoryViewportHeight = $(window).height(); // 화면크기
        

        window.addEventListener('scroll', function() {
            // 스크롤 해서, 한번이라도 ajax불러왔다면
            if(categoryScrollFlagAitemsBottom)
            {
                return false;
            }

            var categorySCrollTop = $(window).scrollTop(); // scroll 위치

            // swiper 하단위치보다 현재 스크롤 위치가 더 크면
            if(categorySwiperZonePlace < (categoryViewportHeight+categorySCrollTop))
            {
                categoryScrollFlagAitemsBottom = true;

                execAjaxCategory();
            }  
        });
    }
    else // 스크롤 유무와 상관없이 바로 ajax호출
    {
        execAjaxCategory();
    }
</script>
<style type="text/css">
