<style>
  #chatBtn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background-color: #00B336;
    border-radius: 25px;
    display: inline-flex;
    align-items: center;
    padding: 10px 10px;
    cursor: pointer;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    white-space: nowrap;
    box-sizing: border-box;
    z-index: 9999;
  }

  #chatBtn img {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 6px;
    transition: margin-right 0.1s ease;
  }

  #chatBtn.collapsed img {
    margin-right: 0;
  }

  #chatBtn .text {
    display: inline-block;
	font-family : 'Malgun Gothic', '맑은 고딕', 'Apple SD Gothic Neo', 'Sans-serif';
    font-weight: 600;
    font-size: 14px;
    color: white;
    line-height: 30px;
    user-select: none;
    overflow: hidden;
    white-space: nowrap;

    transition: width 0.1s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 1.2s ease-out;
    width: auto;
    opacity: 1;
  }

  #chatBtn.collapsed .text {
    width: 0 !important;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  function createChatBtn() {
    const chatBtn = document.createElement('div');
    chatBtn.id = 'chatBtn';
    chatBtn.setAttribute('aria-label', '꾹AI톡톡 챗봇 상담');
    chatBtn.style.visibility = 'hidden'; // 잠시 숨기기, 이미지 로딩 후 보여줌

    const img = document.createElement('img');
    img.src = 'https://cdn1.domeggook.com/image/cs/ico_headset.png';
    img.alt = '챗봇 아이콘';

    const span = document.createElement('span');
    span.className = 'text';
    span.textContent = '꾹AI:톡톡24H챗봇상담';

    chatBtn.appendChild(img);
    chatBtn.appendChild(span);
    document.body.appendChild(chatBtn);

    img.addEventListener('load', () => {
      chatBtn.style.visibility = 'visible';
      initializeChatBtn(chatBtn, span);
    });

    if (img.complete) {
      chatBtn.style.visibility = 'visible';
      initializeChatBtn(chatBtn, span);
    }
  }

  function initializeChatBtn(chatBtn, textSpan) {
    let lastScrollY = window.scrollY;
    let scrollTimeout;
    let isHovered = false;

    function getTextWidth() {
      textSpan.style.width = 'auto';
      textSpan.style.opacity = '1';
      return textSpan.offsetWidth;
    }

    let maxTextWidth = 0;

    function updateMaxWidth() {
      maxTextWidth = getTextWidth();
      if (!chatBtn.classList.contains('collapsed')) {
        textSpan.style.width = maxTextWidth + 'px';
        textSpan.style.opacity = '1';
      }
    }

    function collapseText() {
      textSpan.style.width = '0';
      textSpan.style.opacity = '0';
    }

    function expandText() {
      textSpan.style.width = maxTextWidth + 'px';
      textSpan.style.opacity = '1';
    }

    function checkScrollDirection() {
      const currentScrollY = window.scrollY;

      if (!isHovered) {
        if (currentScrollY > lastScrollY) {
          chatBtn.classList.add('collapsed');
          collapseText();
        } else if (currentScrollY < lastScrollY) {
          chatBtn.classList.remove('collapsed');
          expandText();
        }
      }

      lastScrollY = currentScrollY;

      clearTimeout(scrollTimeout);
    }

    window.addEventListener('scroll', checkScrollDirection);

    chatBtn.addEventListener('mouseenter', () => {
      isHovered = true;
      clearTimeout(scrollTimeout);
      chatBtn.classList.remove('collapsed');
      expandText();
    });

    chatBtn.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    window.addEventListener('resize', () => {
      updateMaxWidth();
    });

    updateMaxWidth();
  }

  createChatBtn();
</script>

<!-- 채널톡 스크립트 -->
<script>
function csTalkMethod()
{
	// 중복 로드 방지
	if(window.ChannelIO)
	{
		return false;
	}

	let pluginKey = 'edff9cb1-fb70-4554-be9c-0df7eb516205';
	var w=window;if(w.ChannelIO){return w.console.error("ChannelIO script included twice.");}var ch=function(){ch.c(arguments);};ch.q=[];ch.c=function(args){ch.q.push(args);};w.ChannelIO=ch;function l(){if(w.ChannelIOInitialized){return;}w.ChannelIOInitialized=true;var s=document.createElement("script");s.type="text/javascript";s.async=true;s.src="https://cdn.channel.io/plugin/ch-plugin-web.js";var x=document.getElementsByTagName("script")[0];if(x.parentNode){x.parentNode.insertBefore(s,x);}}if(document.readyState==="complete"){l();}else{w.addEventListener("DOMContentLoaded",l);w.addEventListener("load",l);}



	//멤버유저일경우 필요
	let channelTalk_info = '';

	if(channelTalk_info)
	{
		let channelTalk_sender = JSON.parse(channelTalk_info);

		// 채널톡 멤버유저부트
		ChannelIO('boot', {
		  "pluginKey": pluginKey, // fill your plugin key
		  "id": channelTalk_sender.id,
		  "customLauncherSelector": "#chatBtn",
		  "hideChannelButtonOnBoot": true,
		  "memberId": channelTalk_sender.memberId, // fill user's member id
		  "memberHash": channelTalk_sender.memberHash,
		  "profile": { // fill user's profile
			"memberInfo" : channelTalk_sender.profile.memberInfo,
			"itemList" : channelTalk_sender.profile.itemList,
			"sellList" : channelTalk_sender.profile.sellList,
			"buyList" : channelTalk_sender.profile.buyList,
			"emoneyUse" : channelTalk_sender.profile.emoneyUse,
			"emoneyIn" : channelTalk_sender.profile.emoneyIn,
			"emoneyOut" : channelTalk_sender.profile.emoneyOut,
			"emoneySellerIn" : channelTalk_sender.profile.emoneySellerIn,
			"emoneySellerOut" : channelTalk_sender.profile.emoneySellerOut,
			"couponBuy" : channelTalk_sender.profile.couponBuy,
			"couponUse" : channelTalk_sender.profile.couponUse,
			"pointList" : channelTalk_sender.profile.pointList,
			"schJoin" : channelTalk_sender.profile.schJoin
		  }
		});
	}
	else
	{
		// cid와 sid가 없을경우, 익명유저 부트
		ChannelIO('boot', {
			"pluginKey": pluginKey,
			"customLauncherSelector": "#chatBtn",
			"hideChannelButtonOnBoot": true
		});
	}
}

$(function () {
    // DOM 준비된 후에 실행
	csTalkMethod();

	// 동적으로 생성되는 외부 버튼 감지(둥둥이 x버튼)
	$(document).on('click', '#ch-plugin-entry', function (evnt) {
		$('#chatBtn').show();
	 });
	
	$(document).on('click', '#chatBtn', function () {
		$('#chatBtn').hide();
	});

});

</script>