	$(function(){
		//최상단 메뉴바 오른쪽 영역에서 서브메뉴를 내리는데 사용하는 자바스크립트입니다.
		$('ul#rightMenu').on('mouseenter', 'li.submenu', function(){
			$(this).find('ul.submenu1').show();
		}).on('mouseleave', 'li.submenu', function(){
			$(this).find('ul.submenu1').hide();
		});

		$('ul.submenu1').on('mouseenter', 'li.submenu2control', function(){
			$(this).find('ul.submenu2').show();
		}).on('mouseleave', 'li.submenu2control', function(){
			$(this).find('ul.submenu2').hide();
		});

		//검색창 선택 영역의 서브메뉴를 내리는데 사용하는 자바스크립트입니다.
